{
  "private": true,
  "scripts": {
    "build": "pnpm --filter web build",
    "format": "prettier --check \"**/*.{astro,css,js,json,jsonc,md,ts,tsx,yaml,yml}\"",
    "lint": "markdownlint-cli2 \"**/*.md\" && pnpm --filter web lint",
    "spellcheck": "git ls-files | cspell --no-progress --file-list stdin",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck"
  },
  "devDependencies": {
    "cspell": "^10.4.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
