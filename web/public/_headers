/*
  Content-Security-Policy: frame-src 'none'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Astro hashes each asset's name, so a cached copy never goes stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
