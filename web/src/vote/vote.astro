---
import Head from '@/components/site/Head.astro';
import Header from '@/components/site/Header.astro';
import { VoteApp } from '@/components/vote/VoteApp';
import { SITE_NAME } from '@/lib/site';
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`Vote | ${SITE_NAME}`} description="Blind pairwise voting on local outputs." />
    <meta name="robots" content="noindex" />
  </head>
  <body class="flex min-h-dvh flex-col md:h-dvh">
    <Header />
    <VoteApp client:only="react" />
  </body>
</html>
