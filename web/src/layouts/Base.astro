---
import { cn } from 'cn';

import Head from '@/components/site/Head.astro';
import Header from '@/components/site/Header.astro';
import { container } from '@/components/site/PageParts';
import { REPOSITORY, SITE_NAME } from '@/lib/site';

interface Props {
  /** The page's own title, which the site name follows. */
  title?: string;
  description?: string;
}

const {
  title,
  description = "Leaderboards of AI assistant systems, ranked by one rater's blind pairwise votes or by automated tests.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title === undefined ? SITE_NAME : `${title} | ${SITE_NAME}`}
      description={description}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class={cn(container, 'flex-1 pt-8 pb-16')}>
      <slot />
    </main>
    <footer class="border-t">
      <p class={cn(container, 'py-6 text-sm text-muted-foreground')}>
        {SITE_NAME} is a <a href="https://hakula.xyz/">hakula.xyz</a> project, with its code, cases,
        and reports on <a href={REPOSITORY}>GitHub</a>.
      </p>
    </footer>
  </body>
</html>
