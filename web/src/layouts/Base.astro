---
import Head from '@/components/site/Head.astro';
import Header from '@/components/site/Header.astro';

interface Props {
  /** The page's own title, which the site name follows. */
  title?: string;
  description?: string;
}

const {
  title,
  description = "Leaderboards of AI assistant systems, ranked by one rater's blind pairwise votes or by automated tests.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title === undefined ? 'assistant-bench' : `${title} | assistant-bench`}
      description={description}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pt-8 pb-16 sm:px-6">
      <slot />
    </main>
    <footer class="border-t">
      <p class="mx-auto max-w-6xl px-4 py-6 text-sm text-muted-foreground sm:px-6">
        A <a href="https://hakula.xyz/">hakula.xyz</a> project, with its code, cases, and reports on{' '}
        <a href="https://github.com/hakula139/assistant-bench">GitHub</a>.
      </p>
    </footer>
  </body>
</html>
