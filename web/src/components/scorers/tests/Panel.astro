---
import Systems from '@/components/scorers/tests/Systems.astro';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { formatPercent, formatPercentRange } from '@/lib/format';
import { terms } from '@/lib/glossary';
import { byPassRate } from '@/lib/ranking';
import type { CheckersFamily, CheckersReport, TestsFamily, TestsReport } from '@/lib/reports';
import { reportNames, systemName } from '@/lib/systems';

interface Props {
  family: TestsFamily | CheckersFamily;
}

function passRows({ systems, results }: TestsReport | CheckersReport) {
  const names = reportNames(systems);
  return results.standings
    .map(({ system, pass_rate }) => ({ name: systemName(names, system), pass_rate }))
    .toSorted(byPassRate);
}

const { family } = Astro.props;
const round = family.rounds.at(-1);
const rows = round && passRows(round);
---

{rows ? (
  <Table>
    <TableHeader>
      <TableRow>
        <TableHead>System</TableHead>
        <TableHead numeric>{terms.passRate.term}</TableHead>
        <TableHead numeric>{terms.passInterval.term}</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      {rows.map(({ name, pass_rate }) => (
        <TableRow>
          <TableCell>{name}</TableCell>
          <TableCell numeric>{formatPercent(pass_rate.rate)}</TableCell>
          <TableCell numeric>{formatPercentRange(pass_rate)}</TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
) : (
  <Systems family={family} />
)}
