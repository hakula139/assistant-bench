---
import { TestsBoard } from '@/components/boards/TestsBoard';
import Systems from '@/components/scorers/tests/Systems.astro';
import { note } from '@/components/site/PageParts';
import { testsRounds, type Family } from '@/lib/reports';

interface Props {
  family: Family;
}

const { family } = Astro.props;
const round = testsRounds(family).at(-1);
---

{round ? (
  <TestsBoard client:visible round={round} names={family.systemNames} />
) : (
  <div class="flex flex-col gap-4">
    <p class={note}>No round has closed yet.</p>
    <Systems family={family} />
  </div>
)}
