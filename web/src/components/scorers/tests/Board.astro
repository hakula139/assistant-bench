---
import { TestsBoard } from '@/components/boards/TestsBoard';
import Systems from '@/components/scorers/tests/Systems.astro';
import { note } from '@/components/site/PageParts';
import type { Report } from '@/lib/report';
import { testsRound, type Family } from '@/lib/reports';

interface Props {
  family: Family;
  /** The closed round to show, or nothing before the first round closes. */
  round: Report | undefined;
}

const { family, round: report } = Astro.props;
const round = report && testsRound(report);
---

{round ? (
  <TestsBoard client:visible round={round} />
) : (
  <div class="flex flex-col gap-4">
    <p class={note}>No round has closed yet.</p>
    <Systems family={family} />
  </div>
)}
