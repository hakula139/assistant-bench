---
import { partId } from '@/components/scorers/parts';
import { votesParts } from '@/components/scorers/votes/parts';
import { Forest, ForestLegend } from '@/components/site/Forest';
import { Glossary, type GlossaryEntry } from '@/components/site/Glossary';
import { MethodStrip } from '@/components/site/Method';
import { note, Part } from '@/components/site/PageParts';
import { AXIS_SPAN_BELOW_TOP, EMPTY_DOMAIN, legendMarks, type ForestRow } from '@/lib/forest';
import { formatCount } from '@/lib/format';
import { gates, inferenceNote, terms } from '@/lib/glossary';

const id = (part: keyof typeof votesParts) => partId('votes', part);
const rows: ForestRow[] = [
  {
    system: 'measured',
    name: 'Measured',
    estimate: { score: 1040, interval: { lower: 1000, upper: 1080 } },
    preliminary: false,
  },
  {
    system: 'preliminary',
    name: 'Preliminary',
    estimate: { score: 930, interval: { lower: 840, upper: 1020 } },
    preliminary: true,
  },
  {
    system: 'far-behind',
    name: 'Far behind',
    estimate: { score: 380, interval: { lower: 345, upper: 415 } },
    preliminary: false,
  },
  { system: 'no-votes', name: 'No votes yet', unplaced: 'no-votes' },
];
const columns: GlossaryEntry[] = [
  terms.rank,
  { ...terms.anchor, status: 'anchor' },
  terms.scoreInterval,
  { ...terms.preliminary, status: 'preliminary' },
  terms.unranked,
  terms.votes,
  terms.bothBad,
  terms.gateFailures,
  terms.costLatency,
];
const diagnostics = [terms.splitHalf, terms.leftOut, terms.lengthBias];
---

<MethodStrip of="votes" links={{ gates: `#${id('gates')}`, scores: `#${id('scores')}` }} />
<p>
  With sides counterbalanced, the rater picks the better output of each pair, a tie, or both bad.
</p>

<Part id={id('gates')} title={votesParts.gates}>
  <p>
    A failing output loses its pairs and two identical outputs tie, so these pairs settle without a
    vote.
  </p>
  <Glossary heading="Gate" entries={Object.values(gates)} />
</Part>

<Part id={id('scores')} title={votesParts.scores}>
  <p>
    A penalized Bradley-Terry model fits Elo-like point scores to human votes and settled pairs.
    Ties and both-bad votes count half a win. Each voter's votes share a capped weight across the
    whole family before any category is fitted. Each settled output pairing receives its share of
    that case's sample pairs.
  </p>
  <p>
    Compare scores within one round of one family. Each closed board records its point method,
    anchor, voter cap, interval level, and preliminary threshold under Round settings. Categories
    refit their own comparisons while retaining that round's settings.
  </p>
</Part>

<Part id={id('leaderboard')} title={votesParts.leaderboard}>
  <figure class="flex flex-col gap-4 rounded-lg border p-4">
    <Forest
      client:visible
      caption="Four example point-score rows"
      domain={EMPTY_DOMAIN}
      rows={rows}
    />
    <figcaption class="flex flex-col gap-2">
      <ForestLegend marks={legendMarks(rows, EMPTY_DOMAIN)} />
      <p class={note}>
        The axis starts at most {formatCount(AXIS_SPAN_BELOW_TOP)} points below the top score.
      </p>
    </figcaption>
  </figure>
  <Glossary heading="Column" entries={columns} />
  <p>
    A dash marks a missing value. A category view refits that category's comparisons, while columns
    labeled "all categories" retain family-wide values. A score is preliminary while its interval is
    wider than the round's recorded threshold, and category scores, which carry no interval, are
    always preliminary.
  </p>
</Part>

<Part id={id('uncertainty')} title={votesParts.uncertainty}>
  <p>{inferenceNote}</p>
  <p>
    The interval comes from a sandwich variance of the fit that treats all votes on one case as one
    draw, since a case can favor one system for reasons the next case does not share. It narrows as
    cases grow, while more votes on the same cases narrow it less. Round settings record the
    interval level, and the summary gives the voters and cases behind it.
  </p>
  <p>
    Each interval measures a score against the field's average, so a bar that clears another
    system's point does not by itself separate the two. The note under the board names the leader
    and the systems that a test of the score gap, using the same variance, cannot separate from it.
    A round whose votes all favor one pane, or where one system wins every comparison, has no
    intervals, since the variance collapses there. Categories hold too few cases for an interval and
    show points only.
  </p>
</Part>

<Part id={id('summary')} title={votesParts.summary}>
  <Glossary heading="Figure" entries={diagnostics} />
</Part>
