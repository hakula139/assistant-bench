---
import { partId } from '@/components/scorers/parts';
import { votesParts } from '@/components/scorers/votes/parts';
import { Forest, ForestLegend } from '@/components/site/Forest';
import { Glossary, type GlossaryEntry } from '@/components/site/Glossary';
import { MethodStrip } from '@/components/site/Method';
import { Part } from '@/components/site/PageParts';
import { legendMarks, type ForestRow } from '@/lib/forest';
import { gates, inferenceNote, terms } from '@/lib/glossary';
import { NET_DOMAIN } from '@/lib/ranking';

const id = (part: keyof typeof votesParts) => partId('votes', part);
const rows: ForestRow[] = [
  {
    system: 'example-a',
    name: 'Example A',
    estimate: { score: 42 },
    preliminary: true,
  },
  {
    system: 'example-b',
    name: 'Example B',
    estimate: { score: 9 },
    preliminary: true,
  },
  {
    system: 'example-c',
    name: 'Example C',
    estimate: { score: -61 },
    preliminary: true,
  },
  { system: 'no-votes', name: 'No votes yet', unplaced: 'no-votes' },
];
const columns: GlossaryEntry[] = [
  terms.rank,
  { ...terms.preliminary, status: 'preliminary' },
  terms.unrankedNet,
  terms.votes,
  terms.bothBad,
  terms.gateFailures,
  terms.costLatency,
];
const diagnostics = [terms.splitHalf, terms.leftOut, terms.lengthBias];
---

<MethodStrip of="votes" links={{ gates: `#${id('gates')}`, scores: `#${id('scores')}` }} />
<p>With sides counterbalanced, voters pick the better output of each pair, a tie, or both bad.</p>

<Part id={id('gates')} title={votesParts.gates}>
  <p>
    A failing output loses its pairs and two identical outputs tie, so these pairs settle without a
    vote.
  </p>
  <Glossary heading="Gate" entries={Object.values(gates)} />
</Part>

<Part id={id('scores')} title={votesParts.scores}>
  <p>
    Scores estimate net points per 100 comparisons against the same reference system. A win earns
    one point, a loss costs one, and a tie earns zero. Both bad costs each system a point. Each vote
    counts once, and each settled output pair receives its share of the case's sample pairs.
  </p>
  <p>
    Bradley-Terry estimates the preference between systems. A separate fit adjusts the chance of
    both bad for the opponent. Categories refit their own comparisons with the same reference.
    Archived Elo rounds display the method and voter cap they used.
  </p>
</Part>

<Part id={id('leaderboard')} title={votesParts.leaderboard}>
  <figure class="flex flex-col gap-4 rounded-lg border p-4">
    <Forest
      client:visible
      caption="Example net points per 100 comparisons"
      domain={NET_DOMAIN}
      rows={rows}
    />
    <figcaption class="flex flex-col gap-2">
      <ForestLegend marks={legendMarks(rows, NET_DOMAIN)} />
    </figcaption>
  </figure>
  <Glossary heading="Column" entries={columns} />
  <p>
    A dash marks a missing value. Columns labeled "all categories" retain family-wide values in a
    category view.
  </p>
</Part>

<Part id={id('uncertainty')} title={votesParts.uncertainty}>
  <p>
    Net scores are preliminary point estimates. Systems stay unranked until their comparisons
    support an estimate against the reference.
  </p>
  <p>Archived Elo intervals treat one case as one draw. {inferenceNote}</p>
</Part>

<Part id={id('summary')} title={votesParts.summary}>
  <Glossary heading="Figure" entries={diagnostics} />
</Part>
