---
import { VotesBoard } from '@/components/boards/VotesBoard';
import { drawnMarks, Forest, ForestLegend } from '@/components/site/Forest';
import { note } from '@/components/site/PageParts';
import { EMPTY_DOMAIN, unmeasuredRows } from '@/lib/forest';
import { boardLabels } from '@/lib/method';
import type { Report } from '@/lib/report';
import { boardPath, configOf, votesRound, type Family } from '@/lib/reports';

interface Props {
  family: Family;
  /** The closed round to show, or nothing before the first round closes. */
  round: Report | undefined;
}

const { family, round: report } = Astro.props;
const config = configOf(family, 'votes');
const round = report && votesRound(report);
const rows =
  round === undefined ? unmeasuredRows(config.systems, config.reference, family.systemNames) : [];
---

{round === undefined ? (
  <div class="flex flex-col gap-4">
    <p class={note}>No round has closed yet.</p>
    <Forest
      client:visible
      caption={`${family.title} systems, none measured yet`}
      rows={rows}
      domain={EMPTY_DOMAIN}
      large
    />
    <ForestLegend marks={drawnMarks(rows, EMPTY_DOMAIN)} />
  </div>
) : (
  <VotesBoard client:load base={boardPath(family)} round={round} labels={boardLabels(config)} />
)}
