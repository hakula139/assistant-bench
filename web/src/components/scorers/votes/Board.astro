---
import { VotesBoard } from '@/components/boards/VotesBoard';
import { drawnMarks, Forest, ForestLegend } from '@/components/site/Forest';
import { note } from '@/components/site/PageParts';
import { EMPTY_DOMAIN, unmeasuredRows } from '@/lib/forest';
import { boardLabels } from '@/lib/method';
import { boardPath, configOf, votesRounds, type Family } from '@/lib/reports';

interface Props {
  family: Family;
}

const { family } = Astro.props;
const config = configOf(family, 'votes');
const rounds = votesRounds(family);
const rows = unmeasuredRows(config.systems, config.reference, family.systemNames);
---

{rounds.length === 0 ? (
  <div class="flex flex-col gap-4">
    <p class={note}>No round has closed yet.</p>
    <Forest
      client:visible
      caption={`${family.title} systems, none measured yet`}
      rows={rows}
      domain={EMPTY_DOMAIN}
      large
    />
    <ForestLegend marks={drawnMarks(rows, EMPTY_DOMAIN)} />
  </div>
) : (
  <VotesBoard
    client:load
    base={boardPath(family)}
    rounds={rounds}
    names={family.systemNames}
    labels={boardLabels(config)}
  />
)}
