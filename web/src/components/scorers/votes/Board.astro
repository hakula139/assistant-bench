---
import { VotesBoard } from '@/components/boards/VotesBoard';
import { Forest, ForestLegend } from '@/components/site/Forest';
import { note } from '@/components/site/PageParts';
import { EMPTY_DOMAIN, legendMarks, unmeasuredRows } from '@/lib/forest';
import { boardLabels } from '@/lib/method';
import { boardPath, type VotesFamily, type VotesReport } from '@/lib/reports';

interface Props {
  family: VotesFamily;
  /** The released report or closed round to show. */
  round: VotesReport | undefined;
}

const { family, round } = Astro.props;
const { config } = family;
const rows = round === undefined ? unmeasuredRows(config.systems, family.systemNames) : [];
---

{round === undefined ? (
  <div class="flex flex-col gap-4">
    <p class={note}>
      {family.current === null ? 'No current scores.' : 'No round has closed yet.'}
    </p>
    <Forest
      client:visible
      caption={`${family.title} systems, none measured yet`}
      rows={rows}
      domain={EMPTY_DOMAIN}
      large
    />
    <ForestLegend marks={legendMarks(rows, EMPTY_DOMAIN)} />
  </div>
) : (
  <VotesBoard client:load base={boardPath(family)} round={round} labels={boardLabels(config)} />
)}
