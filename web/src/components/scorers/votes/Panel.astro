---
import { panelForest } from '@/components/scorers/votes/forest';
import { Forest } from '@/components/site/Forest';
import { inferenceNote } from '@/lib/glossary';
import { latest, type Family } from '@/lib/reports';

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { rows, domain, anchorScore } = panelForest(family);
const { title } = family;
const results = latest(family)?.results;
---

{results?.scorer === 'votes' ? (
  <>
    <Forest
      client:visible
      caption={`${title} point scores`}
      rows={rows}
      domain={domain}
      anchorScore={anchorScore}
    />
    <p class="text-sm text-muted-foreground">{inferenceNote}</p>
  </>
) : (
  <Forest
    client:visible
    caption={`${title} systems, none measured yet`}
    rows={rows}
    domain={domain}
  />
)}
