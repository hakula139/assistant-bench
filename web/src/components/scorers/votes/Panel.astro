---
import { panelForest } from '@/components/scorers/votes/forest';
import { Forest } from '@/components/site/Forest';
import type { VotesFamily } from '@/lib/reports';

interface Props {
  family: VotesFamily;
}

const { family } = Astro.props;
const { rows, domain, anchorScore } = panelForest(family);
const caption =
  anchorScore === undefined
    ? `${family.title} systems, none measured yet`
    : `${family.title} point scores`;
---

<Forest client:visible caption={caption} rows={rows} domain={domain} anchorScore={anchorScore} />
