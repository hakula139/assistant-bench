---
import { REFERENCE_SCORE, clip, forestTicks, sparseTicks, type ForestRow } from '@/lib/forest';
import { formatInterval, formatScore } from '@/lib/format';

interface Props {
  rows: ForestRow[];
  domain: [number, number];
  /** Names the table for assistive technology. */
  caption: string;
  /** Taller rows, for a family page. */
  large?: boolean;
}

const { rows, domain, caption, large = false } = Astro.props;
const ticks = forestTicks(domain);
const sparse = new Set(sparseTicks(domain));
const position = (value: number) =>
  `${(((value - domain[0]) / (domain[1] - domain[0])) * 100).toFixed(2)}%`;

const unplacedText = {
  'reference': {
    interval: 'Fixed at 1,000 as the reference',
    score: '1,000',
    summary: 'the reference, fixed at 1,000',
  },
  'unranked': {
    interval: 'Unbounded, too few comparisons to place it',
    score: 'unranked',
    summary: 'unranked, too few comparisons to place it',
  },
  'no-votes': { interval: 'Unbounded', score: 'no votes', summary: 'no votes yet' },
};

/** The interval cell's text, which screen readers read under the "95% interval" header. */
function intervalText(row: ForestRow): string {
  if ('estimate' in row) {
    return `${formatInterval(row.estimate.interval)}${row.preliminary ? ', preliminary' : ''}`;
  }
  return unplacedText[row.unplaced].interval;
}

/** The row's hover text, which names the system with its score and interval. */
function summary(row: ForestRow): string {
  if ('estimate' in row) {
    return `${row.system}: ${formatScore(row.estimate.score)}, 95% interval ${intervalText(row)}`;
  }
  return `${row.system}: ${unplacedText[row.unplaced].summary}`;
}
---

<table class="w-full table-fixed border-collapse text-sm">
  <caption class="sr-only">{caption}</caption>
  <colgroup>
    <col class={large ? 'w-36 sm:w-48' : 'w-36'} />
    <col />
    <col class="w-16 sm:w-20" />
  </colgroup>
  <thead>
    <tr>
      <th scope="col" class="sr-only">
        System
      </th>
      <th scope="col" class="relative h-6 font-normal">
        <span class="sr-only">95% interval</span>
        {ticks.map((tick) => (
          <span
            aria-hidden="true"
            class:list={[
              'absolute bottom-1 -translate-x-1/2 text-xs text-faint tabular-nums',
              !sparse.has(tick) && 'max-sm:hidden',
            ]}
            style={{ left: position(tick) }}
          >
            {formatScore(tick)}
          </span>
        ))}
      </th>
      <th scope="col" class="sr-only">
        Score
      </th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const clipped = 'estimate' in row ? clip(row.estimate, domain) : undefined;
      const preliminary = 'estimate' in row && row.preliminary;
      return (
        <tr title={summary(row)}>
          <th scope="row" class="truncate pr-3 text-left font-normal">
            {row.href ? <a href={row.href}>{row.system}</a> : row.system}
          </th>
          <td class:list={['relative p-0', large ? 'h-11' : 'h-8']}>
            <span class="sr-only">{intervalText(row)}</span>
            <span aria-hidden="true">
              {ticks.map((tick) => (
                <span
                  class:list={[
                    'absolute inset-y-0 w-px',
                    tick === REFERENCE_SCORE ? 'bg-faint/40' : 'bg-chart-grid',
                  ]}
                  style={{ left: position(tick) }}
                />
              ))}
              {clipped ? (
                <>
                  <span
                    class:list={[
                      'absolute top-1/2 h-0 -translate-y-1/2 border-t-[3px] border-chart-series',
                      preliminary ? 'border-dashed' : 'border-solid',
                    ]}
                    style={{
                      left: position(clipped.lower),
                      right: `calc(100% - ${position(clipped.upper)})`,
                    }}
                  />
                  {clipped.cutLow && (
                    <svg
                      viewBox="0 0 6 10"
                      class="absolute top-1/2 left-0 h-2.5 w-1.5 -translate-y-1/2 fill-chart-series"
                    >
                      <path d="M6 0 0 5l6 5z" />
                    </svg>
                  )}
                  {!clipped.offScale && (
                    <span
                      class:list={[
                        'absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2',
                        preliminary
                          ? 'border-chart-series bg-background'
                          : 'border-background bg-chart-series',
                      ]}
                      style={{ left: position(clipped.score) }}
                    />
                  )}
                </>
              ) : 'unplaced' in row && row.unplaced === 'reference' ? (
                <span
                  class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-background bg-chart-series"
                  style={{ left: position(REFERENCE_SCORE) }}
                />
              ) : (
                <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 text-faint">
                  <span class="absolute inset-x-1.5 top-1/2 -translate-y-1/2 border-t-2 border-dashed border-current" />
                  <svg
                    viewBox="0 0 6 10"
                    class="absolute top-1/2 left-0 h-2.5 w-1.5 -translate-y-1/2 fill-current"
                  >
                    <path d="M6 0 0 5l6 5z" />
                  </svg>
                  <svg
                    viewBox="0 0 6 10"
                    class="absolute top-1/2 right-0 h-2.5 w-1.5 -translate-y-1/2 fill-current"
                  >
                    <path d="M0 0l6 5-6 5z" />
                  </svg>
                </span>
              )}
            </span>
          </td>
          <td class="pl-3 text-right whitespace-nowrap tabular-nums">
            {'estimate' in row ? (
              formatScore(row.estimate.score)
            ) : row.unplaced === 'reference' ? (
              unplacedText.reference.score
            ) : (
              <span class="text-xs text-faint">{unplacedText[row.unplaced].score}</span>
            )}
          </td>
        </tr>
      );
    })}
  </tbody>
</table>
