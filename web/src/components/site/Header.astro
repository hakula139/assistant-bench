---
import ThemeToggle from '@/components/site/ThemeToggle.astro';
import { localBuild } from '@/integrations/local-vote';
import { getFamilies } from '@/lib/reports';

const families = await getFamilies();
const path = Astro.url.pathname;
const links = [
  ...families.map((family) => ({ href: `/${family.name}/`, label: family.name })),
  { href: '/methodology/', label: 'Methodology' },
  ...(localBuild ? [{ href: '/vote/', label: 'Vote' }] : []),
];
---

<header class="border-b">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
    <a href="/" class="font-semibold text-foreground hover:text-link-hover">
      assistant-bench
    </a>
    <ul class="flex min-w-0 flex-1 items-center gap-4 overflow-x-auto text-sm">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={path.startsWith(href) ? 'page' : undefined}
            class="whitespace-nowrap text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
  </nav>
</header>
