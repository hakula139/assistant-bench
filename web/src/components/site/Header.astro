---
import { cn } from 'cn';

import IntervalMark from '@/components/site/IntervalMark.astro';
import { container, wideContainer } from '@/components/site/PageParts';
import ThemeToggle from '@/components/site/ThemeToggle.astro';
import { localBuild } from '@/integrations/local-vote';
import { getFamilies } from '@/lib/reports';
import { SITE_NAME } from '@/lib/site';

interface Props {
  /** Matches the vote page's wider column. */
  wide?: boolean;
}

const { wide = false } = Astro.props;
const families = await getFamilies();
const path = Astro.url.pathname;
const links = [
  ...families.map((family) => ({ href: `/${family.name}/`, label: family.config.display_name })),
  { href: '/methodology/', label: 'Methodology' },
  ...(localBuild ? [{ href: '/vote/', label: 'Vote' }] : []),
];
---

<header class="border-b">
  <nav
    class={cn(
      wide ? wideContainer : container,
      'flex flex-wrap items-center gap-x-6 gap-y-2 py-3 lg:h-14 lg:flex-nowrap lg:py-0',
    )}
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2 font-semibold text-foreground hover:text-foreground">
      <IntervalMark class="h-3.5 w-8" />
      {SITE_NAME}
    </a>
    <ul class="order-last flex w-full flex-wrap items-center gap-x-4 gap-y-1 text-sm lg:order-none lg:w-auto lg:flex-1 lg:justify-end">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={path.startsWith(href) ? 'page' : undefined}
            class="whitespace-nowrap text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="ml-auto lg:ml-0">
      <ThemeToggle />
    </div>
  </nav>
</header>
