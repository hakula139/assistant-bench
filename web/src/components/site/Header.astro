---
import IntervalMark from '@/components/site/IntervalMark.astro';
import { container, wideContainer } from '@/components/site/PageParts';
import ThemeToggle from '@/components/site/ThemeToggle.astro';
import { SITE_NAME, type HeaderSection } from '@/lib/site';

interface Props {
  /** The header link the page sits under, which the header marks as current. */
  section?: HeaderSection;
  /** Matches the vote page's wider column. */
  wide?: boolean;
}

const { section, wide = false } = Astro.props;
const path = Astro.url.pathname;
const links: { section: HeaderSection; href: string; label: string }[] = [
  { section: 'leaderboards', href: '/', label: 'Leaderboards' },
  { section: 'methodology', href: '/methodology/', label: 'Methodology' },
  { section: 'vote', href: '/vote/', label: 'Vote' },
];
---

<header class="border-b">
  <nav
    class:list={[
      wide ? wideContainer : container,
      'flex flex-wrap items-center gap-x-6 gap-y-2 py-3 lg:h-14 lg:flex-nowrap lg:py-0',
    ]}
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2 font-semibold text-foreground hover:text-foreground">
      <IntervalMark class="h-3.5 w-8" />
      {SITE_NAME}
    </a>
    <ul class="order-last flex w-full flex-wrap items-center gap-x-4 gap-y-1 text-sm lg:order-none lg:w-auto lg:flex-1 lg:justify-end">
      {links.map(({ section: own, href, label }) => (
        <li>
          <a
            href={href}
            aria-current={path === href ? 'page' : own === section ? 'true' : undefined}
            class="whitespace-nowrap text-muted-foreground hover:text-foreground [&[aria-current]]:text-foreground"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="ml-auto lg:ml-0">
      <ThemeToggle />
    </div>
  </nav>
</header>
