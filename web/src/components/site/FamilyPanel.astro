---
import { scorerViews } from '@/components/scorers';
import { ScorerIcon } from '@/components/site/Method';
import { sectionTitle } from '@/components/site/PageParts';
import { scorers } from '@/lib/method';
import { boardPath, latest, type Family } from '@/lib/reports';

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { scorer } = family.config;
const { Panel, roundDetail } = scorerViews[scorer];
const report = latest(family);
const round = report
  ? [`Round ${report.round}`, roundDetail(family)].filter(Boolean).join(' · ')
  : 'No round has closed yet';
---

<section
  class="flex flex-col gap-3 lg:row-span-2 lg:grid lg:grid-rows-subgrid"
  aria-labelledby={`family-${family.name}`}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b pb-2">
    <h3 id={`family-${family.name}`} class={sectionTitle}>
      <a href={boardPath(family)} class="text-foreground hover:text-link">
        {family.config.display_name}
      </a>
    </h3>
    <p class="flex items-center gap-1.5 self-center text-sm text-muted-foreground">
      <ScorerIcon scorer={scorer} />
      <span class="sr-only">{scorers[scorer].title}:</span>
      {round}
    </p>
  </div>
  <div class="flex flex-col gap-3">
    <Panel family={family} />
  </div>
</section>
