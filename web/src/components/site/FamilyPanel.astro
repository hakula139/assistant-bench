---
import Forest from '@/components/site/Forest.astro';
import { EMPTY_DOMAIN, forestDomain, roundRows, unmeasuredRows } from '@/lib/forest';
import { MISSING, formatCountOf, formatLeaderNote, formatPercent } from '@/lib/format';
import { latest, type Family } from '@/lib/reports';

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { config } = family;
const report = latest(family);
const results = report?.results;
const status = report
  ? `Round ${report.round}${results?.scorer === 'votes' ? `, ${formatCountOf(results.votes, 'vote')}` : ''}`
  : 'No round has closed yet';
---

<section class="space-y-3" aria-labelledby={`family-${family.name}`}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 border-b pb-2">
    <h2 id={`family-${family.name}`} class="text-lg font-semibold">
      <a href={`/${family.name}/`} class="text-foreground hover:text-link">
        {family.name}
      </a>
    </h2>
    <p class="text-sm text-muted-foreground">{status}</p>
  </div>
  {config.scorer === 'votes' ? (
    results?.scorer === 'votes' ? (
      <>
        <Forest
          caption={`${family.name} scores with 95% intervals`}
          rows={roundRows(family.name, config.systems, results)}
          domain={forestDomain(results.standings)}
        />
        <p class="text-sm">
          <span class="text-muted-foreground">Leader: </span>
          {[results.decision?.leader, formatLeaderNote(results.decision)]
            .filter(Boolean)
            .join(', ')}
        </p>
      </>
    ) : (
      <Forest
        caption={`${family.name} systems, none measured yet`}
        rows={unmeasuredRows(config.systems, config.reference)}
        domain={EMPTY_DOMAIN}
      />
    )
  ) : results?.scorer === 'tests' ? (
    <ul class="space-y-1 text-sm">
      {results.standings
        .toSorted((a, b) => b.pass_rate - a.pass_rate)
        .map((standing) => (
          <li class="flex justify-between gap-4">
            <span>{standing.system}</span>
            <span class="tabular-nums">{formatPercent(standing.pass_rate)} pass</span>
          </li>
        ))}
    </ul>
  ) : (
    <p class="text-sm text-muted-foreground">{config.systems.join(', ') || MISSING}</p>
  )}
</section>
