---
import { renderSections, scorerViews } from '@/components/scorers';
import { partId } from '@/components/scorers/parts';
import { PageHeader, Section, stack } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import type { Scorer } from '@/lib/family';
import { scorers } from '@/lib/method';
import { SOURCE } from '@/lib/site';

const docs = `${SOURCE}/blob/main/docs/design`;
const sections = [
  ...Object.entries(scorerViews).map(([scorer, { Method, parts }]) => ({
    id: scorer,
    title: scorers[scorer as Scorer].title,
    Method,
    parts: Object.entries(parts).map(([part, title]) => ({
      id: partId(scorer as Scorer, part),
      title,
    })),
  })),
  ...Object.entries(renderSections).map(([id, { title, Method }]) => ({
    id,
    title,
    Method,
    parts: [],
  })),
];

const contents = [
  { id: 'systems', title: 'Systems and rounds', parts: [] },
  ...sections,
  { id: 'limits', title: 'Known limits', parts: [] },
];
---

<Base title="Methodology" section="methodology">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-x-16 lg:gap-y-10">
    <div class="lg:col-start-1">
      <PageHeader title="Methodology" />
    </div>

    <nav
      aria-label="On this page"
      class="flex flex-col gap-2 text-sm lg:sticky lg:top-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start"
    >
      <p class="font-medium">On this page</p>
      <ul class="flex flex-col gap-1.5">
        {contents.map(({ id, title, parts }) => (
          <li class="flex flex-col gap-1.5">
            <a href={`#${id}`} class="self-start text-muted-foreground hover:text-foreground">
              {title}
            </a>
            {parts.length > 0 && (
              <ul class="flex flex-col gap-1.5 border-l pl-3">
                {parts.map((part) => (
                  <li>
                    <a href={`#${part.id}`} class="text-muted-foreground hover:text-foreground">
                      {part.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <article class:list={[stack, 'leading-relaxed lg:col-start-1']}>
      <Section id="systems" title="Systems and rounds">
        <p>
          Each family compares systems on a common set of cases or tasks. A system fixes the model,
          effort, harness, and prompt. Each dated round records the systems and evidence used to
          produce its leaderboard.
        </p>
      </Section>

      {sections.map(({ id, title, Method }) => (
        <Section id={id} title={title}>
          <Method />
        </Section>
      ))}

      <Section id="limits" title="Known limits">
        <p>
          A voted board reflects the preferences of its voters. The round summary gives their count
          and shows whether they favored longer or shorter outputs. The score has no length
          adjustment.
        </p>
        <p class="text-muted-foreground">
          See the <a href={`${docs}/ranking.md`}>ranking method</a>,{' '}
          <a href={`${docs}/arena.md`}>voting design</a>, and{' '}
          <a href={`${SOURCE}/tree/main/docs/design/families`}>family-specific limitations</a>.
        </p>
      </Section>
    </article>
  </div>
</Base>
