---
import { scorerViews } from '@/components/scorers';
import { partId } from '@/components/scorers/parts';
import { intro, list, PageHeader, Section, stack } from '@/components/site/PageParts';
import { KeptTail } from '@/components/site/Term';
import Base from '@/layouts/Base.astro';
import type { Scorer } from '@/lib/family';
import { terms } from '@/lib/glossary';
import { scorers } from '@/lib/method';
import { REPOSITORY } from '@/lib/site';

const docs = `${REPOSITORY}/blob/main/docs/design`;
const sections = Object.entries(scorerViews).map(([scorer, view]) => ({
  scorer: scorer as Scorer,
  ...view,
}));

const contents = [
  { id: 'systems', title: 'Systems and rounds', parts: [] },
  ...sections.map(({ scorer, parts }) => ({
    id: scorer,
    title: scorers[scorer].title,
    parts: Object.entries(parts).map(([part, title]) => ({ id: partId(scorer, part), title })),
  })),
  { id: 'coding', title: 'Coding', parts: [] },
  { id: 'limits', title: 'Known limits', parts: [] },
];
---

<Base title="Methodology" section="methodology">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-x-16 lg:gap-y-10">
    <div class="lg:col-start-1">
      <PageHeader title="Methodology">
        <p class={intro}>
          Every system in a family answers the same cases or tasks, and the family's scorer turns
          the results into a leaderboard.
        </p>
      </PageHeader>
    </div>

    <nav
      aria-label="On this page"
      class="flex flex-col gap-2 text-sm lg:sticky lg:top-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start"
    >
      <p class="font-medium">On this page</p>
      <ul class="flex flex-col gap-1.5">
        {contents.map(({ id, title, parts }) => (
          <li class="flex flex-col gap-1.5">
            <a href={`#${id}`} class="self-start text-muted-foreground hover:text-foreground">
              {title}
            </a>
            {parts.length > 0 && (
              <ul class="flex flex-col gap-1.5 border-l pl-3">
                {parts.map((part) => (
                  <li>
                    <a href={`#${part.id}`} class="text-muted-foreground hover:text-foreground">
                      {part.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <article class:list={[stack, 'leading-relaxed lg:col-start-1']}>
      <Section id="systems" title="Systems and rounds">
        <p>
          A family is one leaderboard: a fixed set of cases or tasks and the systems that answer
          them. A system is a model with its effort, harness, and prompt, and changing any part
          makes a new system. Each round is a dated snapshot that refits every result so far.
          Families are grouped by aspect, the skill they measure.
        </p>
      </Section>

      {sections.map(({ scorer, Method }) => (
        <Section id={scorer} title={scorers[scorer].title}>
          <Method />
        </Section>
      ))}

      <Section id="coding" title="Coding">
        <p>
          <KeptTail text="A coding family's tasks are a developer's request and a small repository in a sandbox without network access. Every system works on each task through the same agent within the same turn budget, which the board's Run step names." />
        </p>
        <p>
          <KeptTail text="Hidden tests that the agent never sees then grade each solution. A passing solution wins its pairs with failing ones, and two failing solutions tie. The rater votes only between passing solutions, reading each as a diff of the repository without its commit history, much as a reviewer reads a pull request." />
        </p>
        <p>
          The tests settle every pair they separate and the votes decide the rest, with no fixed
          weight between them. The {terms.failedTests.term} column gives each system's share of
          failing solutions, and <a href="#votes">Votes</a>{' '}
          <KeptTail text="explains the rest of the board." />
        </p>
      </Section>

      <Section id="limits" title="Known limits">
        <ul class:list={['list-disc', list]}>
          <li>
            One person casts every vote, so each voted board reflects that person's preferences.
          </li>
          <li>
            Voted scores are relative, so only the both-bad and gate-failure rates measure outputs
            on an absolute scale.
          </li>
          <li>
            Voted scores carry no length adjustment. Each round summary reports whether the rater
            favors longer or shorter outputs.
          </li>
        </ul>
        <p class="text-muted-foreground">
          The design notes on <a href={`${docs}/ranking.md`}>ranking</a>, the{' '}
          <a href={`${docs}/arena.md`}>vote arena</a>, and each{' '}
          <a href={`${REPOSITORY}/tree/main/docs/design/families`}>family</a> cover the math.
        </p>
      </Section>
    </article>
  </div>
</Base>
