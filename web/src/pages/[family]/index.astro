---
import type { GetStaticPaths } from 'astro';

import { TestsBoard } from '@/components/boards/TestsBoard';
import { VotesBoard } from '@/components/boards/VotesBoard';
import Base from '@/layouts/Base.astro';
import { getFamilies, latest, testsRounds, votesRounds, type Family } from '@/lib/reports';

export const getStaticPaths = (async () => {
  const families = await getFamilies();
  return families.map((family) => ({ params: { family: family.name }, props: { family } }));
}) satisfies GetStaticPaths;

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { scorer } = latest(family).results;
const summaries = {
  votes: {
    text: 'Ranked by blind pairwise votes, with 95% intervals and the reference system at 1,000.',
    guide: '/methodology/#leaderboard',
  },
  tests: {
    text: 'Ranked by the share of trials that pass the task tests.',
    guide: '/methodology/#tests',
  },
} satisfies Record<typeof scorer, { text: string; guide: string }>;
const summary = summaries[scorer];
const board = (() => {
  switch (scorer) {
    case 'votes':
      return { scorer, rounds: votesRounds(family) };
    case 'tests':
      return { scorer, rounds: testsRounds(family) };
  }
})();
---

<Base title={family.name} description={`${family.name}: ${summary.text}`}>
  <header class="mb-8 space-y-2">
    <h1 class="text-[1.75rem] leading-tight font-semibold">{family.name}</h1>
    <p class="max-w-prose text-muted-foreground">
      {summary.text} <a href={summary.guide}>How to read this board</a>
    </p>
  </header>
  {board.scorer === 'votes' ? (
    <VotesBoard client:load family={family.name} rounds={board.rounds} />
  ) : (
    <TestsBoard rounds={board.rounds} />
  )}
</Base>
