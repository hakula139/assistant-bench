---
import type { GetStaticPaths } from 'astro';
import { BookOpen } from 'lucide-react';

import { scorerViews } from '@/components/scorers';
import { MethodStrip } from '@/components/site/Method';
import { PageHeader } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import { scorers } from '@/lib/method';
import { getFamilies, type Family } from '@/lib/reports';

export const getStaticPaths = (async () => {
  const families = await getFamilies();
  return families.map((family) => ({ params: { family: family.name }, props: { family } }));
}) satisfies GetStaticPaths;

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { config } = family;
const title = config.display_name;
const { Board } = scorerViews[config.scorer];
---

<Base title={title} description={`${title}: ${scorers[config.scorer].summary}.`}>
  <PageHeader title={title}>
    <MethodStrip scorer={config.scorer} config={config.scorer === 'votes' ? config : undefined} />
    <a href={`/methodology/#${config.scorer}`} class="inline-flex items-center gap-2 text-sm">
      <BookOpen className="size-4" aria-hidden="true" />
      How to read this board
    </a>
  </PageHeader>
  <Board family={family} />
</Base>
