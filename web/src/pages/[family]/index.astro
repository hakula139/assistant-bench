---
import type { GetStaticPaths } from 'astro';

import { TestsBoard } from '@/components/boards/TestsBoard';
import { VotesBoard } from '@/components/boards/VotesBoard';
import { Forest } from '@/components/site/Forest';
import { pageTitle } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import { EMPTY_DOMAIN, unmeasuredRows } from '@/lib/forest';
import { MISSING, formatCountOf } from '@/lib/format';
import { getFamilies, testsRounds, votesRounds, type Family } from '@/lib/reports';

export const getStaticPaths = (async () => {
  const families = await getFamilies();
  return families.map((family) => ({ params: { family: family.name }, props: { family } }));
}) satisfies GetStaticPaths;

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { config } = family;
const { summary, guide, board } = (() => {
  switch (config.scorer) {
    case 'votes':
      return {
        summary: `Ranked by blind pairwise votes, with 95% intervals and ${config.reference} as the reference at 1,000.`,
        guide: '/methodology/#leaderboard',
        board: { scorer: config.scorer, reference: config.reference, rounds: votesRounds(family) },
      };
    case 'tests':
      return {
        summary: 'Ranked by the share of trials that pass the task tests.',
        guide: '/methodology/#tests',
        board: { scorer: config.scorer, rounds: testsRounds(family) },
      };
  }
})();
---

<Base title={family.name} description={`${family.name}: ${summary}`}>
  <header class="mb-8 space-y-2">
    <h1 class={pageTitle}>{family.name}</h1>
    <p class="max-w-prose text-muted-foreground">
      {summary} <a href={guide}>How to read this board</a>
    </p>
  </header>
  {family.rounds.length === 0 ? (
    <div class="space-y-4">
      <p class="max-w-prose">
        No round has closed yet, and the first one holds{' '}
        {formatCountOf(config.systems.length, 'system')}.
        {board.scorer === 'votes' && ' Until it closes, every interval is unbounded.'}
      </p>
      {board.scorer === 'votes' && (
        <Forest
          caption={`${family.name} systems, none measured yet`}
          rows={unmeasuredRows(config.systems, board.reference)}
          domain={EMPTY_DOMAIN}
          large
        />
      )}
      {board.scorer === 'tests' && <p>{config.systems.join(', ') || MISSING}</p>}
    </div>
  ) : board.scorer === 'votes' ? (
    <VotesBoard client:load family={family.name} rounds={board.rounds} />
  ) : (
    <TestsBoard rounds={board.rounds} />
  )}
</Base>
