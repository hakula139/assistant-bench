---
import type { GetStaticPaths } from 'astro';

import { TestsBoard } from '@/components/boards/TestsBoard';
import { VotesBoard } from '@/components/boards/VotesBoard';
import Base from '@/layouts/Base.astro';
import { getFamilies, latest, testsRounds, votesRounds, type Family } from '@/lib/reports';

export const getStaticPaths = (async () => {
  const families = await getFamilies();
  return families.map((family) => ({ params: { family: family.name }, props: { family } }));
}) satisfies GetStaticPaths;

interface Props {
  family: Family;
}

const { family } = Astro.props;
const { results } = latest(family);
const { summary, guide, board } = (() => {
  switch (results.scorer) {
    case 'votes':
      return {
        summary: `Ranked by blind pairwise votes, with 95% intervals and ${results.reference} as the reference at 1,000.`,
        guide: '/methodology/#leaderboard',
        board: { scorer: results.scorer, rounds: votesRounds(family) },
      };
    case 'tests':
      return {
        summary: 'Ranked by the share of trials that pass the task tests.',
        guide: '/methodology/#tests',
        board: { scorer: results.scorer, rounds: testsRounds(family) },
      };
  }
})();
---

<Base title={family.name} description={`${family.name}: ${summary}`}>
  <header class="mb-8 space-y-2">
    <h1 class="text-[1.75rem] leading-tight font-semibold">{family.name}</h1>
    <p class="max-w-prose text-muted-foreground">
      {summary} <a href={guide}>How to read this board</a>
    </p>
  </header>
  {board.scorer === 'votes' ? (
    <VotesBoard client:load family={family.name} rounds={board.rounds} />
  ) : (
    <TestsBoard rounds={board.rounds} />
  )}
</Base>
