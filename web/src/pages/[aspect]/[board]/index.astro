---
import type { GetStaticPaths } from 'astro';

import BoardPage from '@/components/site/BoardPage.astro';
import { familyPaths, getFamilies, type BoardLink, type Family } from '@/lib/reports';

export const getStaticPaths = (async () =>
  familyPaths(await getFamilies())) satisfies GetStaticPaths;

interface Props {
  family: Family;
  /** The boards of the family's aspect, itself included. */
  boards: BoardLink[];
}

const { family, boards } = Astro.props;
---

<BoardPage family={family} boards={boards} />
