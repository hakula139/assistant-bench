---
import type { GetStaticPaths } from 'astro';

import {
  CategoryTable,
  DefectsTable,
  DistributionTable,
  HeadToHeadTable,
  RoundsTable,
} from '@/components/boards/SystemTables';
import { DotRangePlot, type DotRange } from '@/components/charts/DotRangePlot';
import { ForestPlot, type ForestPlotRow } from '@/components/charts/ForestPlot';
import { TableTwin } from '@/components/charts/TableTwin';
import { BoardSwitcher } from '@/components/site/BoardSwitcher';
import { note, PageHeader, Section, stack, Stat, statList } from '@/components/site/PageParts';
import { Hint, StatusMark } from '@/components/site/Term';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import Base from '@/layouts/Base.astro';
import { aspects } from '@/lib/aspects';
import { sharedDomain } from '@/lib/forest';
import { formatCount, formatInterval, formatRank, formatScore } from '@/lib/format';
import { terms } from '@/lib/glossary';
import type { Distribution, Standing } from '@/lib/report';
import {
  boardPath,
  getFamilies,
  systemPaths,
  votesRounds,
  type BoardLink,
  type Family,
} from '@/lib/reports';
import { systemName } from '@/lib/systems';

export const getStaticPaths = (async () =>
  systemPaths(await getFamilies())) satisfies GetStaticPaths;

interface Props {
  family: Family;
  system: string;
  /** The system's pages on the boards of the family's aspect, this one included. */
  boards: BoardLink[];
}

const { family, system, boards } = Astro.props;
const rounds = votesRounds(family);
const names = family.systemNames;
const name = (item: string) => systemName(names, item);
const appearances = rounds.flatMap(({ round, results }) => {
  const standing = results.standings.find((item) => item.system === system);
  return standing
    ? [{ round, reference: results.reference, anchor: results.anchor, results, standing }]
    : [];
});
const { round, results, standing } = appearances[appearances.length - 1];
const standings = results.standings;

const headToHead = results.head_to_head
  .filter((pair) => pair.system === system)
  .toSorted((a, b) => b.win_rate - a.win_rate);
const categoryRows = results.categories.flatMap(
  ({ category, standings: refits }): ForestPlotRow[] => {
    const refit = refits.find((item) => item.system === system);
    return refit ? [{ label: category, refit }] : [];
  },
);
const categoryDomain = sharedDomain(results.categories.map((board) => board.standings));
const distributionRows = (pick: (item: Standing) => Distribution | null) =>
  standings.flatMap((item): DotRange[] => {
    const distribution = pick(item);
    return distribution
      ? [
          {
            label: name(item.system),
            value: distribution.p50,
            range: { lower: distribution.p10, upper: distribution.p90 },
            emphasis: item.system === system,
          },
        ]
      : [];
  });
const tokenRows = distributionRows((item) => item.output_tokens);
const latencyRows = distributionRows((item) => item.latency_sec);
const roundRows = appearances.map(({ round, reference, anchor, standing }) => ({
  round,
  reference,
  anchor,
  standing,
}));
---

<Base title={`${name(system)} on ${family.title}`} section="leaderboards">
  <PageHeader title={name(system)}>
    <Fragment slot="context">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href={`/#${family.aspect}`}>
              {aspects[family.aspect].title}
            </BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbLink href={boardPath(family)}>{family.config.display_name}</BreadcrumbLink>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </Fragment>
    <Fragment slot="status">
      {standing.preliminary && <StatusMark client:visible status="preliminary" />}
    </Fragment>
    <BoardSwitcher aspect={family.aspect} boards={boards} />
    <dl class={statList}>
      <Stat label="Score" detail={`(${formatInterval(standing.interval)})`}>
        {formatScore(standing.score)}
      </Stat>
      <Stat label="Rank">{formatRank(standing.best_rank, standing.worst_rank)}</Stat>
      <Stat label="Votes">
        <Hint slot="detail" client:visible term={terms.decisive}>
          ({formatCount(standing.decisive_votes)} decisive)
        </Hint>
        {formatCount(standing.votes)}
      </Stat>
      <Stat label="Round">{round}</Stat>
    </dl>
  </PageHeader>

  <div class={stack}>
    {headToHead.length > 0 && (
      <Section title="Head to head">
        <p class={note}>
          Win rate against each opponent, where ties and both-bad votes count half.
        </p>
        <DotRangePlot
          client:visible
          rows={headToHead.map((pair) => ({ label: name(pair.opponent), value: pair.win_rate }))}
          label="Win rate"
          format="percent"
          baseline={0.5}
        />
        <TableTwin>
          <HeadToHeadTable headToHead={headToHead} names={names} />
        </TableTwin>
      </Section>
    )}

    {categoryRows.length > 0 && (
      <Section title="Categories">
        <ForestPlot
          client:visible
          rows={categoryRows}
          labels={categoryRows.map((row) => row.label)}
          domain={categoryDomain}
          label="Category scores with 95% intervals"
        />
        <TableTwin>
          <CategoryTable categories={categoryRows} />
        </TableTwin>
      </Section>
    )}

    <Section title="Output length and latency">
      <p class={note}>Each system's median and 10th to 90th percentile range.</p>
      <div class="grid gap-6 lg:grid-cols-2">
        {tokenRows.length > 0 && (
          <DotRangePlot client:visible rows={tokenRows} label="Output tokens" format="tokens" />
        )}
        {latencyRows.length > 0 && (
          <DotRangePlot client:visible rows={latencyRows} label="Latency" format="seconds" />
        )}
      </div>
      <TableTwin>
        <DistributionTable standings={standings} system={system} names={names} />
      </TableTwin>
    </Section>

    <Section title="Issues">
      <p class={note}>Votes that tagged this system's output with each issue.</p>
      <DefectsTable client:visible standing={standing} />
    </Section>

    <Section title="Rounds">
      <RoundsTable client:visible appearances={roundRows} names={names} />
    </Section>
  </div>
</Base>
