---
import { scorerViews } from '@/components/scorers';
import FamilyPanel from '@/components/site/FamilyPanel.astro';
import { ForestLegend } from '@/components/site/Forest';
import { AspectTitle } from '@/components/site/Method';
import { groupTitle, intro } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import { groupByAspect } from '@/lib/aspects';
import { unionMarks } from '@/lib/forest';
import { getFamilies } from '@/lib/reports';
import { SITE_DESCRIPTION } from '@/lib/site';

const families = await getFamilies();
const marks = unionMarks(families.map((family) => scorerViews[family.config.scorer].marks(family)));
---

<Base section="leaderboards">
  <section class="flex flex-col gap-4">
    <h1 class="text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
      AI models and agents ranked on everyday work
    </h1>
    <p class={intro}>
      {SITE_DESCRIPTION} The <a href="/methodology/">methodology</a> explains how to read them.
    </p>
  </section>

  {families.length === 0 ? (
    <p class="text-muted-foreground">No leaderboard is published yet.</p>
  ) : (
    <div class="flex flex-col gap-6">
      {marks.length > 0 && <ForestLegend marks={marks} />}
      <div class="flex flex-col gap-20">
        {groupByAspect(families).map(({ aspect, members }) => (
          <section class="flex flex-col gap-6" aria-labelledby={aspect}>
            <h2 id={aspect} class:list={[groupTitle, 'flex items-center gap-2']}>
              <AspectTitle aspect={aspect} />
            </h2>
            <div class="grid gap-12 lg:grid-cols-2">
              {members.map((family) => (
                <FamilyPanel family={family} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}
</Base>
