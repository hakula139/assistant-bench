---
import { scorerViews } from '@/components/scorers';
import FamilyPanel from '@/components/site/FamilyPanel.astro';
import { ForestLegend } from '@/components/site/Forest';
import { intro } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import { unionMarks } from '@/lib/forest';
import { getFamilies } from '@/lib/reports';

const families = await getFamilies();
const marks = unionMarks(families.map((family) => scorerViews[family.config.scorer].marks(family)));
---

<Base>
  <section class="space-y-4">
    <h1 class="text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
      AI assistants ranked on everyday work
    </h1>
    <p class={intro}>
      Leaderboards of AI assistant systems, ranked by one rater's blind pairwise votes or by
      automated tests. The <a href="/methodology/">methodology</a> explains how to read them.
    </p>
  </section>

  {families.length === 0 ? (
    <p class="text-muted-foreground">No family is listed yet.</p>
  ) : (
    <div class="space-y-6">
      {marks.length > 0 && <ForestLegend marks={marks} />}
      <div class="grid gap-x-12 gap-y-12 lg:grid-cols-2">
        {families.map((family) => (
          <FamilyPanel family={family} />
        ))}
      </div>
    </div>
  )}
</Base>
