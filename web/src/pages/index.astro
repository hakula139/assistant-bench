---
import { cn } from 'cn';

import FamilyPanel from '@/components/site/FamilyPanel.astro';
import { note } from '@/components/site/PageParts';
import Base from '@/layouts/Base.astro';
import { getFamilies } from '@/lib/reports';

const families = await getFamilies();
const unmeasured = families.some(
  (family) => family.config.scorer === 'votes' && family.rounds.length === 0,
);
---

<Base>
  <section class="mb-12 max-w-3xl space-y-4">
    <h1 class="text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
      AI assistants ranked blind, with 95% intervals
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">
      Leaderboards of AI assistant systems, one per family of everyday tasks, ranked by one rater's
      blind pairwise votes or by automated tests. The <a href="/methodology/">methodology</a>{' '}
      explains how to read them.
    </p>
  </section>

  {families.length === 0 ? (
    <p class="text-muted-foreground">No family is listed yet.</p>
  ) : (
    <div class="grid gap-x-12 gap-y-12 lg:grid-cols-2">
      {families.map((family) => (
        <FamilyPanel family={family} />
      ))}
    </div>
  )}
  {unmeasured && (
    <p class={cn('mt-8', note)}>
      Until a family's first round closes, every interval is unbounded, and its reference sits at
      1,000.
    </p>
  )}
</Base>
