---
import { FamiliesTable, type FamilySummary } from '@/components/site/FamiliesTable';
import Base from '@/layouts/Base.astro';
import { formatCountOf, formatLeaderNote } from '@/lib/format';
import type { Report } from '@/lib/report';
import { getFamilies, latest } from '@/lib/reports';

function standing(
  results: Report['results'],
): Pick<FamilySummary, 'systems' | 'leader' | 'leaderNote' | 'measure'> {
  switch (results.scorer) {
    case 'votes':
      return {
        systems: results.standings.length + results.unranked.length,
        leader: results.decision?.leader,
        leaderNote: formatLeaderNote(results.decision),
        measure: formatCountOf(results.votes, 'vote'),
      };
    case 'tests':
      return {
        systems: results.standings.length,
        leader: results.standings.toSorted((a, b) => b.pass_rate - a.pass_rate)[0]?.system,
        leaderNote: null,
        measure: 'Task tests',
      };
  }
}

const families = (await getFamilies()).map((family): FamilySummary => {
  const { round, results } = latest(family);
  return { name: family.name, round, rounds: family.rounds.length, ...standing(results) };
});
---

<Base>
  <section class="mb-10 max-w-prose space-y-3">
    <h1 class="text-[1.75rem] leading-tight font-semibold">assistant-bench</h1>
    <p class="text-muted-foreground">
      Leaderboards of AI assistant systems, one per family of everyday tasks, ranked by one rater's
      blind pairwise votes or by automated tests. The <a href="/methodology/">methodology</a>{' '}
      explains how to read them.
    </p>
  </section>

  {families.length === 0 ? (
    <p class="text-muted-foreground">No round has closed yet.</p>
  ) : (
    <FamiliesTable families={families} />
  )}
</Base>
