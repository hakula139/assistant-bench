---
import { FamiliesTable, type FamilySummary } from '@/components/site/FamiliesTable';
import Base from '@/layouts/Base.astro';
import { formatTieBreak } from '@/lib/format';
import { getFamilies, latest } from '@/lib/reports';

const families = (await getFamilies()).map((family): FamilySummary => {
  const { round, results } = latest(family);
  return {
    name: family.name,
    round,
    rounds: family.rounds.length,
    systems: results.standings.length,
    leader:
      results.scorer === 'votes'
        ? results.decision.leader
        : results.standings.toSorted((a, b) => b.pass_rate - a.pass_rate)[0]?.system,
    tieBreak: results.scorer === 'votes' ? formatTieBreak(results.decision) : null,
    measure: results.scorer === 'votes' ? `${results.votes} votes` : 'Task tests',
  };
});
---

<Base>
  <section class="mb-10 max-w-prose space-y-3">
    <h1 class="text-[1.75rem] leading-tight font-semibold">assistant-bench</h1>
    <p class="text-muted-foreground">
      Every system receives the same instruction, and one rater compares the outputs blind and in
      pairs. Each family is one kind of task with its own leaderboard, and each closed round adds
      its votes to the family's board.
    </p>
  </section>

  {families.length === 0 ? (
    <p class="text-muted-foreground">No round has closed yet.</p>
  ) : (
    <FamiliesTable families={families} />
  )}
</Base>
