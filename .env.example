# Copy to .env. `bench` searches the working directory and its parents.
# Configure each API base independently. The Messages SDK appends /v1/messages to its base.
# Both APIs share the key file, optional CA file, and JSON object in BENCH_API_HEADERS.
# BENCH_API_LOCAL_ADDRESS binds locally and bypasses proxies, e.g. 0.0.0.0 for IPv4.
BENCH_API_BASE_URL=https://api.example.com/v1
BENCH_ANTHROPIC_BASE_URL=https://api.example.com/anthropic
BENCH_API_KEY_FILE=/path/to/api-key
BENCH_API_CA_FILE=
BENCH_API_HEADERS=
BENCH_API_LOCAL_ADDRESS=

# Cloudflare API token file with D1 Edit access for bench arena and bench close.
BENCH_D1_TOKEN_FILE=
