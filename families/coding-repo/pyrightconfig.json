{
  "extends": "../../pyproject.toml",
  "include": ["shared", "tasks"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "tasks/*/environment/app",
    "tasks/*/tests/hidden"
  ],
  "extraPaths": ["shared/tests"],
  "pythonVersion": "3.13",
  "executionEnvironments": [
    {
      "root": "tasks/add-matrix-channel",
      "extraPaths": ["tasks/add-matrix-channel/tests", "tasks/add-matrix-channel/environment/app"]
    },
    {
      "root": "tasks/add-top-words",
      "extraPaths": ["tasks/add-top-words/tests", "tasks/add-top-words/environment/app"]
    },
    {
      "root": "tasks/fix-lru-cache",
      "extraPaths": ["tasks/fix-lru-cache/tests", "tasks/fix-lru-cache/environment/app"]
    },
    {
      "root": "tasks/fix-pagination",
      "extraPaths": ["tasks/fix-pagination/tests", "tasks/fix-pagination/environment/app"]
    },
    {
      "root": "tasks/implement-durations",
      "extraPaths": ["tasks/implement-durations/tests", "tasks/implement-durations/environment/app"]
    },
    {
      "root": "tasks/refactor-parsers",
      "extraPaths": ["tasks/refactor-parsers/tests", "tasks/refactor-parsers/environment/app"]
    },
    {
      "root": "tasks/rename-customer-api",
      "extraPaths": ["tasks/rename-customer-api/tests", "tasks/rename-customer-api/environment/app"]
    },
    {
      "root": "tasks",
      "extraPaths": ["shared/tests"]
    }
  ]
}
