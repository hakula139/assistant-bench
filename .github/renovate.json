{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hakula139/nixos-config//.github/renovate-preset"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The GitLab Pages job's Node image, which a variable names",
      "managerFilePatterns": ["/^\\.gitlab/ci/pages\\.yml$/"],
      "matchStrings": ["BENCH_NODE_IMAGE: (?<depName>node):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The GitLab Pages job's pnpm, which a variable names",
      "managerFilePatterns": ["/^\\.gitlab/ci/pages\\.yml$/"],
      "matchStrings": ["BENCH_PNPM_VERSION: (?<currentValue>\\S+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "The released LiteLLM dependency supports Python below 3.15",
      "matchManagers": ["pep621", "pyenv"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.14(?:\\.|$)/"
    },
    {
      "description": "A task image is part of the task's content, which needs a version bump Renovate cannot make",
      "matchFileNames": [
        "families/*/tasks/**",
        "families/coding-repo/shared/environment/Dockerfile"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint and @astrojs/check do not yet accept TypeScript 7",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
