{
  "$defs": {
    "Category": {
      "enum": [
        "bug-fix",
        "docs",
        "essay",
        "feature",
        "fiction",
        "message",
        "refactor",
        "reply",
        "review",
        "smoke"
      ],
      "type": "string"
    },
    "CategoryBoard": {
      "additionalProperties": false,
      "description": "A category point fit in the overall anchor's connected component.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/CategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        },
        "unranked": {
          "items": {
            "type": "string"
          },
          "title": "Unranked",
          "type": "array"
        }
      },
      "required": [
        "category",
        "votes",
        "effective_votes",
        "standings",
        "unranked"
      ],
      "title": "CategoryBoard",
      "type": "object"
    },
    "CategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "decisive_votes": {
          "minimum": 0,
          "title": "Decisive Votes",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "score",
        "votes",
        "effective_votes",
        "decisive_votes"
      ],
      "title": "CategoryStanding",
      "type": "object"
    },
    "Defect": {
      "enum": [
        "facts",
        "mechanics",
        "tone",
        "formulaic",
        "length",
        "scope",
        "conventions",
        "complexity",
        "testing",
        "clarity"
      ],
      "type": "string"
    },
    "Distribution": {
      "additionalProperties": false,
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "FamilyName": {
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
      "type": "string"
    },
    "HeadToHead": {
      "additionalProperties": false,
      "description": "Human choices between two systems, with half credit for either tie.\n\nThe outcome counts are raw choices, while `effective_votes` and `win_rate` use\nthe actors' weights.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "opponent": {
          "title": "Opponent",
          "type": "string"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "wins": {
          "title": "Wins",
          "type": "integer"
        },
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "both_bad": {
          "title": "Both Bad",
          "type": "integer"
        },
        "win_rate": {
          "title": "Win Rate",
          "type": "number"
        }
      },
      "required": [
        "system",
        "opponent",
        "votes",
        "effective_votes",
        "wins",
        "losses",
        "ties",
        "both_bad",
        "win_rate"
      ],
      "title": "HeadToHead",
      "type": "object"
    },
    "LedgerProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "export_id": {
          "minLength": 1,
          "title": "Export Id",
          "type": "string"
        },
        "export_digest": {
          "minLength": 1,
          "title": "Export Digest",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "event_cutoff": {
          "minimum": 0,
          "title": "Event Cutoff",
          "type": "integer"
        },
        "receipt_cutoff": {
          "minimum": 0,
          "title": "Receipt Cutoff",
          "type": "integer"
        },
        "family_revision": {
          "minimum": 0,
          "title": "Family Revision",
          "type": "integer"
        },
        "analysis_sequence": {
          "minimum": 0,
          "title": "Analysis Sequence",
          "type": "integer"
        },
        "evaluation_id": {
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "sampling_point_snapshot_id": {
          "minLength": 1,
          "title": "Sampling Point Snapshot Id",
          "type": "string"
        },
        "weighted_evidence_digest": {
          "minLength": 1,
          "title": "Weighted Evidence Digest",
          "type": "string"
        },
        "fitted_point_snapshot_id": {
          "minLength": 1,
          "title": "Fitted Point Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "export_id",
        "export_digest",
        "namespace",
        "captured_at",
        "event_cutoff",
        "receipt_cutoff",
        "family_revision",
        "analysis_sequence",
        "evaluation_id",
        "publication_id",
        "policy_id",
        "sampling_point_snapshot_id",
        "weighted_evidence_digest",
        "fitted_point_snapshot_id"
      ],
      "title": "LedgerProvenance",
      "type": "object"
    },
    "PassRate": {
      "additionalProperties": false,
      "description": "A mean of per-task shares with its 95% Clopper-Pearson interval over tasks.",
      "properties": {
        "rate": {
          "$ref": "#/$defs/Share"
        },
        "lower": {
          "$ref": "#/$defs/Share"
        },
        "upper": {
          "$ref": "#/$defs/Share"
        }
      },
      "required": [
        "rate",
        "lower",
        "upper"
      ],
      "title": "PassRate",
      "type": "object"
    },
    "PublicSystem": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "description": "Public label frozen for this round, including retired systems.",
          "title": "Display Name",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Configuration provenance, unknown when null.",
          "title": "Fingerprint"
        }
      },
      "required": [
        "display_name",
        "fingerprint"
      ],
      "title": "PublicSystem",
      "type": "object"
    },
    "Results": {
      "discriminator": {
        "mapping": {
          "tests": "#/$defs/TestsResults",
          "votes": "#/$defs/VotesResults"
        },
        "propertyName": "scorer"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VotesResults"
        },
        {
          "$ref": "#/$defs/TestsResults"
        }
      ]
    },
    "RoundName": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Share": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "Standing": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "description": "Point estimate on the round's recorded score scale.",
          "title": "Score",
          "type": "number"
        },
        "rank": {
          "description": "Competition rank of the point score.",
          "title": "Rank",
          "type": "integer"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "description": "Eligible human row weight, excluding settled comparisons.",
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "decisive_votes": {
          "minimum": 0,
          "title": "Decisive Votes",
          "type": "integer"
        },
        "both_bad_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Both Bad Rate"
        },
        "outputs": {
          "description": "Outputs that finished without an error.",
          "title": "Outputs",
          "type": "integer"
        },
        "gate_failure_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure share among outputs with a verdict, including errored agents.",
          "title": "Gate Failure Rate"
        },
        "pass_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PassRate"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tests pass rate over tasks, null when the system's outputs lack rewards."
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Cost Usd"
        },
        "p50_latency_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50 Latency Sec"
        },
        "output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_sec": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "defects": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Raw tagged-vote counts in the family's defect order.",
          "propertyNames": {
            "$ref": "#/$defs/Defect"
          },
          "title": "Defects",
          "type": "object"
        }
      },
      "required": [
        "system",
        "score",
        "rank",
        "votes",
        "effective_votes",
        "decisive_votes",
        "both_bad_rate",
        "outputs",
        "gate_failure_rate",
        "pass_rate",
        "mean_cost_usd",
        "p50_latency_sec",
        "output_tokens",
        "latency_sec",
        "defects"
      ],
      "title": "Standing",
      "type": "object"
    },
    "TestsCategory": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/TestsCategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "standings"
      ],
      "title": "TestsCategory",
      "type": "object"
    },
    "TestsCategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "tasks": {
          "minimum": 1,
          "title": "Tasks",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        }
      },
      "required": [
        "system",
        "tasks",
        "pass_rate"
      ],
      "title": "TestsCategoryStanding",
      "type": "object"
    },
    "TestsDecision": {
      "additionalProperties": false,
      "description": "The top pass rate and the systems a paired sign test cannot separate from it.",
      "properties": {
        "leader": {
          "title": "Leader",
          "type": "string"
        },
        "tied": {
          "items": {
            "type": "string"
          },
          "title": "Tied",
          "type": "array"
        }
      },
      "required": [
        "leader",
        "tied"
      ],
      "title": "TestsDecision",
      "type": "object"
    },
    "TestsResults": {
      "additionalProperties": false,
      "description": "Pass rates on Harbor task tests, where every system ran every task.",
      "properties": {
        "scorer": {
          "const": "tests",
          "title": "Scorer",
          "type": "string"
        },
        "samples": {
          "description": "Trials the family runs per task and system, the k of pass^k.",
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/TestsStanding"
          },
          "minItems": 1,
          "title": "Standings",
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/TestsCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/TestsDecision"
        }
      },
      "required": [
        "scorer",
        "samples",
        "standings",
        "categories",
        "decision"
      ],
      "title": "TestsResults",
      "type": "object"
    },
    "TestsStanding": {
      "additionalProperties": false,
      "description": "One system's pass rates, with cost and latency over its error-free trials.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "tasks": {
          "minimum": 1,
          "title": "Tasks",
          "type": "integer"
        },
        "trials": {
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "errored": {
          "minimum": 0,
          "title": "Errored",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        },
        "pass_hat_k": {
          "anyOf": [
            {
              "$ref": "#/$defs/Share"
            },
            {
              "type": "null"
            }
          ],
          "description": "Share of tasks whose `samples` trials all passed, null for one sample."
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Cost Usd"
        },
        "p50_latency_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50 Latency Sec"
        }
      },
      "required": [
        "system",
        "tasks",
        "trials",
        "errored",
        "pass_rate",
        "pass_hat_k",
        "mean_cost_usd",
        "p50_latency_sec"
      ],
      "title": "TestsStanding",
      "type": "object"
    },
    "VotesMethod": {
      "additionalProperties": false,
      "properties": {
        "l2_penalty": {
          "description": "Penalty on system logits, excluding the sided intercept.",
          "exclusiveMinimum": 0,
          "title": "L2 Penalty",
          "type": "number"
        },
        "points_per_logit": {
          "exclusiveMinimum": 0,
          "title": "Points Per Logit",
          "type": "number"
        },
        "anchor_score": {
          "title": "Anchor Score",
          "type": "number"
        },
        "actor_cap": {
          "description": "Each of an actor's `n` eligible choices weighs `min(1, actor_cap / n)`.",
          "exclusiveMinimum": 0,
          "title": "Actor Cap",
          "type": "integer"
        }
      },
      "required": [
        "l2_penalty",
        "points_per_logit",
        "anchor_score",
        "actor_cap"
      ],
      "title": "VotesMethod",
      "type": "object"
    },
    "VotesResults": {
      "additionalProperties": false,
      "description": "Point estimates and descriptive diagnostics on eligible comparisons.",
      "properties": {
        "scorer": {
          "const": "votes",
          "title": "Scorer",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/VotesMethod"
        },
        "rules": {
          "$ref": "#/$defs/VotesRules"
        },
        "provenance": {
          "$ref": "#/$defs/LedgerProvenance"
        },
        "reference": {
          "description": "Configured reference, whether or not comparisons connect it.",
          "title": "Reference",
          "type": "string"
        },
        "anchor": {
          "description": "Ranked system fixed at the recorded anchor score.",
          "title": "Anchor",
          "type": "string"
        },
        "votes": {
          "description": "Eligible human choices across every component.",
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "description": "Eligible human row weight across every component, excluding settlements.",
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "dropped_votes": {
          "description": "Accepted choices excluded from the fit, including repeats and moderation.",
          "title": "Dropped Votes",
          "type": "integer"
        },
        "sessions": {
          "description": "Sessions containing at least one eligible human choice.",
          "title": "Sessions",
          "type": "integer"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/Standing"
          },
          "title": "Standings",
          "type": "array"
        },
        "unranked": {
          "description": "Entrants in the frozen evaluation outside the comparison component.",
          "items": {
            "type": "string"
          },
          "title": "Unranked",
          "type": "array"
        },
        "head_to_head": {
          "items": {
            "$ref": "#/$defs/HeadToHead"
          },
          "title": "Head To Head",
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryBoard"
          },
          "title": "Categories",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Left-pane advantage in score points, null without ranked human rows.",
          "title": "Position"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Score points per length-difference standard deviation, if identifiable.",
          "title": "Length"
        },
        "split_half_tau": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Order agreement between alternating eligible sessions, when measurable.",
          "title": "Split Half Tau"
        }
      },
      "required": [
        "scorer",
        "method",
        "rules",
        "provenance",
        "reference",
        "anchor",
        "votes",
        "effective_votes",
        "dropped_votes",
        "sessions",
        "standings",
        "unranked",
        "head_to_head",
        "categories",
        "position",
        "length",
        "split_half_tau"
      ],
      "title": "VotesResults",
      "type": "object"
    },
    "VotesRules": {
      "additionalProperties": false,
      "properties": {
        "preliminary_decisive_votes": {
          "description": "Raw decisive votes below which a standing is preliminary.",
          "exclusiveMinimum": 0,
          "title": "Preliminary Decisive Votes",
          "type": "integer"
        }
      },
      "required": [
        "preliminary_decisive_votes"
      ],
      "title": "VotesRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A closed round of one family, written to `reports/<family>/<round>.json`.",
  "properties": {
    "family": {
      "$ref": "#/$defs/FamilyName"
    },
    "round": {
      "$ref": "#/$defs/RoundName"
    },
    "closed_at": {
      "format": "date-time",
      "title": "Closed At",
      "type": "string"
    },
    "systems": {
      "additionalProperties": {
        "$ref": "#/$defs/PublicSystem"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Systems",
      "type": "object"
    },
    "results": {
      "$ref": "#/$defs/Results"
    }
  },
  "required": [
    "family",
    "round",
    "closed_at",
    "systems",
    "results"
  ],
  "title": "Report",
  "type": "object"
}
