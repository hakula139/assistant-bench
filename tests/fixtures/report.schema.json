{
  "$defs": {
    "Category": {
      "enum": [
        "bug-fix",
        "docs",
        "essay",
        "feature",
        "fiction",
        "message",
        "refactor",
        "reply",
        "review",
        "smoke"
      ],
      "type": "string"
    },
    "CategoryBoard": {
      "additionalProperties": false,
      "description": "A category point fit in the overall anchor's connected component.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/CategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        },
        "unranked": {
          "items": {
            "type": "string"
          },
          "title": "Unranked",
          "type": "array"
        }
      },
      "required": [
        "category",
        "votes",
        "effective_votes",
        "standings",
        "unranked"
      ],
      "title": "CategoryBoard",
      "type": "object"
    },
    "CategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "score",
        "votes"
      ],
      "title": "CategoryStanding",
      "type": "object"
    },
    "CheckRule": {
      "enum": [
        "ellipsis",
        "han-punctuation",
        "curly-quotes",
        "paragraph-lines",
        "list-spacing",
        "tree-comments",
        "forbidden-marker"
      ],
      "type": "string"
    },
    "CheckersCategory": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/CheckersCategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "standings"
      ],
      "title": "CheckersCategory",
      "type": "object"
    },
    "CheckersCategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "cases": {
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        }
      },
      "required": [
        "system",
        "cases",
        "pass_rate"
      ],
      "title": "CheckersCategoryStanding",
      "type": "object"
    },
    "CheckersResults": {
      "additionalProperties": false,
      "description": "Strict binary case scores, applicable-rule diagnostics and paired effects.",
      "properties": {
        "scorer": {
          "const": "checkers",
          "title": "Scorer",
          "type": "string"
        },
        "samples": {
          "const": 1,
          "title": "Samples",
          "type": "integer"
        },
        "checker_revision": {
          "title": "Checker Revision",
          "type": "string"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/CheckersStanding"
          },
          "minItems": 1,
          "title": "Standings",
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CheckersCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RuleDiagnostic"
          },
          "title": "Rules",
          "type": "array"
        },
        "prompt_effects": {
          "items": {
            "$ref": "#/$defs/PromptEffect"
          },
          "title": "Prompt Effects",
          "type": "array"
        }
      },
      "required": [
        "scorer",
        "samples",
        "checker_revision",
        "standings",
        "categories",
        "decision",
        "rules",
        "prompt_effects"
      ],
      "title": "CheckersResults",
      "type": "object"
    },
    "CheckersStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "cases": {
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "responses": {
          "minimum": 1,
          "title": "Responses",
          "type": "integer"
        },
        "errored": {
          "minimum": 0,
          "title": "Errored",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Cost Usd"
        },
        "cost_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostGap"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_sec": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system",
        "cases",
        "responses",
        "errored",
        "pass_rate",
        "mean_cost_usd",
        "cost_gap",
        "latency_sec"
      ],
      "title": "CheckersStanding",
      "type": "object"
    },
    "CostGap": {
      "enum": [
        "unpriced",
        "unreported"
      ],
      "type": "string"
    },
    "Cutoff": {
      "additionalProperties": false,
      "description": "What closing read from one store, which freshness compares with the store.",
      "properties": {
        "id": {
          "description": "The largest vote ID older than the undo window, or 0 when the store held none.",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "votes": {
          "description": "The store's votes with IDs up to `id` that no exclusion removed.",
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "votes"
      ],
      "title": "Cutoff",
      "type": "object"
    },
    "Cutoffs": {
      "additionalProperties": false,
      "description": "Each store's cutoff at closing, null when it contributed no cut.",
      "properties": {
        "production": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cutoff"
            },
            {
              "type": "null"
            }
          ]
        },
        "private": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cutoff"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "production",
        "private"
      ],
      "title": "Cutoffs",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "The top standing and the systems its scorer's test cannot separate from it.",
      "properties": {
        "leader": {
          "title": "Leader",
          "type": "string"
        },
        "tied": {
          "items": {
            "type": "string"
          },
          "title": "Tied",
          "type": "array"
        }
      },
      "required": [
        "leader",
        "tied"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Defect": {
      "enum": [
        "facts",
        "mechanics",
        "tone",
        "formulaic",
        "length",
        "scope",
        "conventions",
        "complexity",
        "testing",
        "clarity"
      ],
      "type": "string"
    },
    "Distribution": {
      "additionalProperties": false,
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "FamilyName": {
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
      "type": "string"
    },
    "HeadToHead": {
      "additionalProperties": false,
      "description": "Human choices between two systems, with half credit for either tie.\n\nThe outcome counts are raw choices, while `win_rate` uses the actors' weights.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "opponent": {
          "title": "Opponent",
          "type": "string"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "wins": {
          "title": "Wins",
          "type": "integer"
        },
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "both_bad": {
          "title": "Both Bad",
          "type": "integer"
        },
        "win_rate": {
          "title": "Win Rate",
          "type": "number"
        }
      },
      "required": [
        "system",
        "opponent",
        "votes",
        "wins",
        "losses",
        "ties",
        "both_bad",
        "win_rate"
      ],
      "title": "HeadToHead",
      "type": "object"
    },
    "PassRate": {
      "additionalProperties": false,
      "description": "A mean of per-task shares with its 95% Clopper-Pearson interval over tasks.",
      "properties": {
        "rate": {
          "$ref": "#/$defs/Share"
        },
        "lower": {
          "$ref": "#/$defs/Share"
        },
        "upper": {
          "$ref": "#/$defs/Share"
        }
      },
      "required": [
        "rate",
        "lower",
        "upper"
      ],
      "title": "PassRate",
      "type": "object"
    },
    "PromptEffect": {
      "additionalProperties": false,
      "description": "Descriptive prompted-minus-bare difference over the same cases.",
      "properties": {
        "bare": {
          "title": "Bare",
          "type": "string"
        },
        "prompted": {
          "title": "Prompted",
          "type": "string"
        },
        "cases": {
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "delta": {
          "maximum": 1,
          "minimum": -1,
          "title": "Delta",
          "type": "number"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bare",
        "prompted",
        "cases",
        "delta",
        "interval"
      ],
      "title": "PromptEffect",
      "type": "object"
    },
    "PublicSystem": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "description": "Public label frozen for this round, including retired systems.",
          "title": "Display Name",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Configuration provenance, unknown when null.",
          "title": "Fingerprint"
        }
      },
      "required": [
        "display_name",
        "fingerprint"
      ],
      "title": "PublicSystem",
      "type": "object"
    },
    "Results": {
      "discriminator": {
        "mapping": {
          "checkers": "#/$defs/CheckersResults",
          "tests": "#/$defs/TestsResults",
          "votes": "#/$defs/VotesResults"
        },
        "propertyName": "scorer"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VotesResults"
        },
        {
          "$ref": "#/$defs/TestsResults"
        },
        {
          "$ref": "#/$defs/CheckersResults"
        }
      ]
    },
    "RoundName": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "RuleDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "#/$defs/CheckRule"
        },
        "system": {
          "title": "System",
          "type": "string"
        },
        "applicable_cases": {
          "minimum": 1,
          "title": "Applicable Cases",
          "type": "integer"
        },
        "applicable_responses": {
          "minimum": 1,
          "title": "Applicable Responses",
          "type": "integer"
        },
        "passed_responses": {
          "minimum": 0,
          "title": "Passed Responses",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/Share"
        }
      },
      "required": [
        "rule",
        "system",
        "applicable_cases",
        "applicable_responses",
        "passed_responses",
        "pass_rate"
      ],
      "title": "RuleDiagnostic",
      "type": "object"
    },
    "ScoreInterval": {
      "additionalProperties": false,
      "description": "A score interval's bounds on the round's recorded score scale.",
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ScoreInterval",
      "type": "object"
    },
    "Share": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "SplitDiagnostic": {
      "additionalProperties": false,
      "description": "Descriptive public-minus-held-out scores centered on the common field mean.",
      "properties": {
        "public_cases": {
          "title": "Public Cases",
          "type": "integer"
        },
        "held_out_cases": {
          "title": "Held Out Cases",
          "type": "integer"
        },
        "unavailable": {
          "anyOf": [
            {
              "enum": [
                "insufficient_cases",
                "no_common_field",
                "disconnected_field",
                "unidentifiable_field",
                "separated_fit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/SplitScoreDifference"
          },
          "title": "Scores",
          "type": "array"
        }
      },
      "required": [
        "public_cases",
        "held_out_cases",
        "unavailable",
        "scores"
      ],
      "title": "SplitDiagnostic",
      "type": "object"
    },
    "SplitScoreDifference": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "difference": {
          "title": "Difference",
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/ScoreInterval"
        }
      },
      "required": [
        "system",
        "difference",
        "interval"
      ],
      "title": "SplitScoreDifference",
      "type": "object"
    },
    "Standing": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "description": "Point estimate on the round's recorded score scale.",
          "title": "Score",
          "type": "number"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ],
          "description": "The case-clustered interval at `method.interval_level`, null below two cases\nor when the round's comparisons are separated."
        },
        "rank": {
          "description": "Competition rank of the point score.",
          "title": "Rank",
          "type": "integer"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "decisive_votes": {
          "minimum": 0,
          "title": "Decisive Votes",
          "type": "integer"
        },
        "both_bad_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Both Bad Rate"
        },
        "gate_failure_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure share among outputs with a verdict, including errored agents.",
          "title": "Gate Failure Rate"
        },
        "pass_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PassRate"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tests pass rate over tasks, null when the system's outputs lack rewards."
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null unless every output that finished without an error reports a cost.",
          "title": "Mean Cost Usd"
        },
        "cost_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostGap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why finished outputs lack a mean cost: `unpriced` when an output with known\nusage has no cost, and `unreported` when only outputs without usage do."
        },
        "output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_sec": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "defects": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Raw tagged-vote counts in the family's defect order.",
          "propertyNames": {
            "$ref": "#/$defs/Defect"
          },
          "title": "Defects",
          "type": "object"
        }
      },
      "required": [
        "system",
        "score",
        "interval",
        "rank",
        "votes",
        "decisive_votes",
        "both_bad_rate",
        "gate_failure_rate",
        "pass_rate",
        "mean_cost_usd",
        "cost_gap",
        "output_tokens",
        "latency_sec",
        "defects"
      ],
      "title": "Standing",
      "type": "object"
    },
    "TestsCategory": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/TestsCategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "category",
        "standings"
      ],
      "title": "TestsCategory",
      "type": "object"
    },
    "TestsCategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "tasks": {
          "minimum": 1,
          "title": "Tasks",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        }
      },
      "required": [
        "system",
        "tasks",
        "pass_rate"
      ],
      "title": "TestsCategoryStanding",
      "type": "object"
    },
    "TestsResults": {
      "additionalProperties": false,
      "description": "Pass rates on Harbor task tests, where every system ran every task.",
      "properties": {
        "scorer": {
          "const": "tests",
          "title": "Scorer",
          "type": "string"
        },
        "samples": {
          "description": "Trials the family runs per task and system, the k of pass^k.",
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/TestsStanding"
          },
          "minItems": 1,
          "title": "Standings",
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/TestsCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/Decision",
          "description": "The top pass rate and the systems a paired sign test cannot separate from it."
        }
      },
      "required": [
        "scorer",
        "samples",
        "standings",
        "categories",
        "decision"
      ],
      "title": "TestsResults",
      "type": "object"
    },
    "TestsStanding": {
      "additionalProperties": false,
      "description": "One system's pass rates, with cost and latency over its error-free trials.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "tasks": {
          "minimum": 1,
          "title": "Tasks",
          "type": "integer"
        },
        "trials": {
          "minimum": 1,
          "title": "Trials",
          "type": "integer"
        },
        "errored": {
          "minimum": 0,
          "title": "Errored",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/PassRate"
        },
        "pass_hat_k": {
          "anyOf": [
            {
              "$ref": "#/$defs/Share"
            },
            {
              "type": "null"
            }
          ],
          "description": "Share of tasks whose `samples` trials all passed, null for one sample."
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null unless every trial that finished without an error reports a cost.",
          "title": "Mean Cost Usd"
        },
        "cost_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostGap"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why finished trials lack a mean cost: `unpriced` when a trial with known\nusage has no cost, and `unreported` when only trials without usage do."
        },
        "latency_sec": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system",
        "tasks",
        "trials",
        "errored",
        "pass_rate",
        "pass_hat_k",
        "mean_cost_usd",
        "cost_gap",
        "latency_sec"
      ],
      "title": "TestsStanding",
      "type": "object"
    },
    "VotesMethod": {
      "additionalProperties": false,
      "properties": {
        "l2_penalty": {
          "description": "Penalty on system logits, excluding the sided intercept.",
          "exclusiveMinimum": 0,
          "title": "L2 Penalty",
          "type": "number"
        },
        "points_per_logit": {
