{
  "$defs": {
    "CappedHumanWeights": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "actor-proportional-cap",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "cap": {
          "exclusiveMinimum": 0,
          "title": "Cap",
          "type": "integer"
        },
        "scope": {
          "const": "family-evaluation",
          "title": "Scope",
          "type": "string"
        },
        "repeat_handling": {
          "const": "excluded",
          "title": "Repeat Handling",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "cap",
        "scope",
        "repeat_handling"
      ],
      "title": "CappedHumanWeights",
      "type": "object"
    },
    "Category": {
      "enum": [
        "bug-fix",
        "docs",
        "essay",
        "feature",
        "fiction",
        "message",
        "refactor",
        "reply",
        "review",
        "smoke"
      ],
      "type": "string"
    },
    "CategoryBoard": {
      "additionalProperties": false,
      "description": "A category point fit in the overall anchor's connected component.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/CategoryStanding"
          },
          "title": "Standings",
          "type": "array"
        },
        "unranked": {
          "items": {
            "type": "string"
          },
          "title": "Unranked",
          "type": "array"
        }
      },
      "required": [
        "category",
        "votes",
        "effective_votes",
        "standings",
        "unranked"
      ],
      "title": "CategoryBoard",
      "type": "object"
    },
    "CategoryStanding": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "interval": {
          "title": "Interval",
          "type": "null"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "decisive_votes": {
          "minimum": 0,
          "title": "Decisive Votes",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "score",
        "interval",
        "votes",
        "effective_votes",
        "decisive_votes"
      ],
      "title": "CategoryStanding",
      "type": "object"
    },
    "Defect": {
      "enum": [
        "facts",
        "mechanics",
        "tone",
        "formulaic",
        "length",
        "scope",
        "conventions",
        "complexity",
        "testing",
        "clarity"
      ],
      "type": "string"
    },
    "Distribution": {
      "additionalProperties": false,
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "FamilyName": {
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
      "type": "string"
    },
    "HeadToHead": {
      "additionalProperties": false,
      "description": "Human choices between two systems, with half credit for either tie.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "opponent": {
          "title": "Opponent",
          "type": "string"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "wins": {
          "title": "Wins",
          "type": "integer"
        },
        "losses": {
          "title": "Losses",
          "type": "integer"
        },
        "ties": {
          "title": "Ties",
          "type": "integer"
        },
        "both_bad": {
          "title": "Both Bad",
          "type": "integer"
        },
        "win_rate": {
          "title": "Win Rate",
          "type": "number"
        }
      },
      "required": [
        "system",
        "opponent",
        "votes",
        "effective_votes",
        "wins",
        "losses",
        "ties",
        "both_bad",
        "win_rate"
      ],
      "title": "HeadToHead",
      "type": "object"
    },
    "HumanWeights": {
      "discriminator": {
        "mapping": {
          "actor-proportional-cap": "#/$defs/CappedHumanWeights",
          "unit": "#/$defs/UnitHumanWeights"
        },
        "propertyName": "name"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UnitHumanWeights"
        },
        {
          "$ref": "#/$defs/CappedHumanWeights"
        }
      ]
    },
    "LedgerProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "export_id": {
          "minLength": 1,
          "title": "Export Id",
          "type": "string"
        },
        "export_digest": {
          "minLength": 1,
          "title": "Export Digest",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "event_cutoff": {
          "minimum": 0,
          "title": "Event Cutoff",
          "type": "integer"
        },
        "receipt_cutoff": {
          "minimum": 0,
          "title": "Receipt Cutoff",
          "type": "integer"
        },
        "family_revision": {
          "minimum": 0,
          "title": "Family Revision",
          "type": "integer"
        },
        "analysis_sequence": {
          "minimum": 0,
          "title": "Analysis Sequence",
          "type": "integer"
        },
        "evaluation_id": {
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "sampling_point_snapshot_id": {
          "minLength": 1,
          "title": "Sampling Point Snapshot Id",
          "type": "string"
        },
        "status": {
          "const": "ledger",
          "title": "Status",
          "type": "string"
        },
        "weighted_evidence_digest": {
          "minLength": 1,
          "title": "Weighted Evidence Digest",
          "type": "string"
        },
        "fitted_point_snapshot_id": {
          "minLength": 1,
          "title": "Fitted Point Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "export_id",
        "export_digest",
        "namespace",
        "captured_at",
        "event_cutoff",
        "receipt_cutoff",
        "family_revision",
        "analysis_sequence",
        "evaluation_id",
        "publication_id",
        "policy_id",
        "sampling_point_snapshot_id",
        "status",
        "weighted_evidence_digest",
        "fitted_point_snapshot_id"
      ],
      "title": "LedgerProvenance",
      "type": "object"
    },
    "Provenance": {
      "discriminator": {
        "mapping": {
          "ledger": "#/$defs/LedgerProvenance",
          "unrecorded": "#/$defs/UnrecordedProvenance"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UnrecordedProvenance"
        },
        {
          "$ref": "#/$defs/LedgerProvenance"
        }
      ]
    },
    "PublicSystem": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "description": "Public label frozen for this round, including retired systems.",
          "title": "Display Name",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Configuration provenance, unknown when null.",
          "title": "Fingerprint"
        }
      },
      "required": [
        "display_name",
        "fingerprint"
      ],
      "title": "PublicSystem",
      "type": "object"
    },
    "RaterAgreement": {
      "additionalProperties": false,
      "description": "Descriptive agreement of side-swapped repeats with their originals.",
      "properties": {
        "repeats": {
          "title": "Repeats",
          "type": "integer"
        },
        "agreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agreement"
        },
        "below_floor": {
          "title": "Below Floor",
          "type": "boolean"
        }
      },
      "required": [
        "repeats",
        "agreement",
        "below_floor"
      ],
      "title": "RaterAgreement",
      "type": "object"
    },
    "Results": {
      "discriminator": {
        "mapping": {
          "tests": "#/$defs/TestsResults",
          "votes": "#/$defs/VotesResults"
        },
        "propertyName": "scorer"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/VotesResults"
        },
        {
          "$ref": "#/$defs/TestsResults"
        }
      ]
    },
    "RoundName": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "SettledWeights": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "sample-pair-share",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SettledWeights",
      "type": "object"
    },
    "Standing": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "score": {
          "description": "Point estimate on the round's recorded score scale.",
          "title": "Score",
          "type": "number"
        },
        "interval": {
          "title": "Interval",
          "type": "null"
        },
        "rank": {
          "description": "Competition rank of the point score.",
          "title": "Rank",
          "type": "integer"
        },
        "best_rank": {
          "title": "Best Rank",
          "type": "null"
        },
        "worst_rank": {
          "title": "Worst Rank",
          "type": "null"
        },
        "votes": {
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "description": "Eligible human row weight, excluding settled comparisons.",
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "decisive_votes": {
          "minimum": 0,
          "title": "Decisive Votes",
          "type": "integer"
        },
        "both_bad_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Both Bad Rate"
        },
        "outputs": {
          "description": "Outputs that finished without an error.",
          "title": "Outputs",
          "type": "integer"
        },
        "gate_failure_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure share among outputs with a verdict, including errored agents.",
          "title": "Gate Failure Rate"
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Cost Usd"
        },
        "p50_latency_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50 Latency Sec"
        },
        "output_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_sec": {
          "anyOf": [
            {
              "$ref": "#/$defs/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "defects": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Raw tagged-vote counts in the family's defect order.",
          "propertyNames": {
            "$ref": "#/$defs/Defect"
          },
          "title": "Defects",
          "type": "object"
        }
      },
      "required": [
        "system",
        "score",
        "interval",
        "rank",
        "best_rank",
        "worst_rank",
        "votes",
        "effective_votes",
        "decisive_votes",
        "both_bad_rate",
        "outputs",
        "gate_failure_rate",
        "mean_cost_usd",
        "p50_latency_sec",
        "output_tokens",
        "latency_sec",
        "defects"
      ],
      "title": "Standing",
      "type": "object"
    },
    "TestsResults": {
      "additionalProperties": false,
      "description": "Pass rates on Harbor task tests, where an errored trial fails.",
      "properties": {
        "scorer": {
          "const": "tests",
          "title": "Scorer",
          "type": "string"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/TestsStanding"
          },
          "title": "Standings",
          "type": "array"
        }
      },
      "required": [
        "scorer",
        "standings"
      ],
      "title": "TestsResults",
      "type": "object"
    },
    "TestsStanding": {
      "additionalProperties": false,
      "description": "One system's pass rate, with cost and latency over its error-free trials.",
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        },
        "errored": {
          "title": "Errored",
          "type": "integer"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "mean_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Cost Usd"
        },
        "p50_latency_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50 Latency Sec"
        }
      },
      "required": [
        "system",
        "trials",
        "errored",
        "pass_rate",
        "mean_cost_usd",
        "p50_latency_sec"
      ],
      "title": "TestsStanding",
      "type": "object"
    },
    "UnavailableInference": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "target": {
          "const": "new-cases-and-voters",
          "title": "Target",
          "type": "string"
        },
        "reason": {
          "const": "population-method-not-validated",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "target",
        "reason"
      ],
      "title": "UnavailableInference",
      "type": "object"
    },
    "UnitHumanWeights": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "unit",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "repeat_handling": {
          "const": "included",
          "title": "Repeat Handling",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "repeat_handling"
      ],
      "title": "UnitHumanWeights",
      "type": "object"
    },
    "UnrecordedProvenance": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unrecorded",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "UnrecordedProvenance",
      "type": "object"
    },
    "VotesMethod": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "bradley-terry",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "l2_penalty": {
          "description": "Penalty on system logits, excluding the sided intercept.",
          "exclusiveMinimum": 0,
          "title": "L2 Penalty",
          "type": "number"
        },
        "points_per_logit": {
          "exclusiveMinimum": 0,
          "title": "Points Per Logit",
          "type": "number"
        },
        "anchor_score": {
          "title": "Anchor Score",
          "type": "number"
        },
        "human_weights": {
          "$ref": "#/$defs/HumanWeights"
        },
        "settled_weights": {
          "$ref": "#/$defs/SettledWeights"
        }
      },
      "required": [
        "name",
        "version",
        "l2_penalty",
        "points_per_logit",
        "anchor_score",
        "human_weights",
        "settled_weights"
      ],
      "title": "VotesMethod",
      "type": "object"
    },
    "VotesResults": {
      "additionalProperties": false,
      "description": "Point estimates and descriptive diagnostics on eligible comparisons.",
      "properties": {
        "scorer": {
          "const": "votes",
          "title": "Scorer",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/VotesMethod"
        },
        "rules": {
          "$ref": "#/$defs/VotesRules"
        },
        "inference": {
          "$ref": "#/$defs/UnavailableInference"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": {
            "status": "unrecorded"
          }
        },
        "reference": {
          "description": "Configured reference, whether or not comparisons connect it.",
          "title": "Reference",
          "type": "string"
        },
        "anchor": {
          "description": "Ranked system fixed at the recorded anchor score.",
          "title": "Anchor",
          "type": "string"
        },
        "votes": {
          "description": "Eligible human choices across every component.",
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        },
        "effective_votes": {
          "description": "Eligible human row weight across every component, excluding settlements.",
          "minimum": 0,
          "title": "Effective Votes",
          "type": "number"
        },
        "dropped_votes": {
          "description": "Accepted choices excluded from the fit, including repeats and moderation.",
          "title": "Dropped Votes",
          "type": "integer"
        },
        "sessions": {
          "description": "Sessions containing at least one eligible human choice.",
          "title": "Sessions",
          "type": "integer"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/Standing"
          },
          "title": "Standings",
          "type": "array"
        },
        "unranked": {
          "description": "Entrants in the frozen evaluation outside the comparison component.",
          "items": {
            "type": "string"
          },
          "title": "Unranked",
          "type": "array"
        },
        "head_to_head": {
          "items": {
            "$ref": "#/$defs/HeadToHead"
          },
          "title": "Head To Head",
          "type": "array"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryBoard"
          },
          "title": "Categories",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Left-pane advantage in score points, null without ranked human rows.",
          "title": "Position"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Score points per length-difference standard deviation, if identifiable.",
          "title": "Length"
        },
        "separability": {
          "title": "Separability",
          "type": "null"
        },
        "split_half_tau": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Order agreement between alternating eligible sessions, when measurable.",
          "title": "Split Half Tau"
        },
        "rater_agreement": {
          "$ref": "#/$defs/RaterAgreement"
        },
        "decision": {
          "title": "Decision",
          "type": "null"
        }
      },
      "required": [
        "scorer",
        "method",
        "rules",
        "inference",
        "reference",
        "anchor",
        "votes",
        "effective_votes",
        "dropped_votes",
        "sessions",
        "standings",
        "unranked",
        "head_to_head",
        "categories",
        "position",
        "length",
        "separability",
        "split_half_tau",
        "rater_agreement",
        "decision"
      ],
      "title": "VotesResults",
      "type": "object"
    },
    "VotesRules": {
      "additionalProperties": false,
      "properties": {
        "preliminary_decisive_votes": {
          "description": "Raw coverage threshold, independent of inference availability.",
          "exclusiveMinimum": 0,
          "title": "Preliminary Decisive Votes",
          "type": "integer"
        },
        "preliminary_decisive_vote_unit": {
          "const": "raw-votes",
          "title": "Preliminary Decisive Vote Unit",
          "type": "string"
        },
        "rater_agreement_floor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Rater Agreement Floor",
          "type": "number"
        }
      },
      "required": [
        "preliminary_decisive_votes",
        "preliminary_decisive_vote_unit",
        "rater_agreement_floor"
      ],
      "title": "VotesRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A closed round of one family, written to `reports/<family>/<round>.json`.",
