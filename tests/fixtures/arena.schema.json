    "title": "ResumeSession",
    "type": "object"
  },
  "receiptQuery": {
    "$defs": {
      "Choice": {
        "enum": ["a", "b", "tie", "both_bad"],
        "type": "string"
      },
      "Defect": {
        "enum": [
          "facts",
          "mechanics",
          "tone",
          "formulaic",
          "length",
          "scope",
          "conventions",
          "complexity",
          "testing",
          "clarity"
        ],
        "type": "string"
      },
      "Defects": {
        "additionalProperties": false,
        "description": "The defects tagged on each side's output.",
        "properties": {
          "a": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Defect"
            },
            "title": "A",
            "type": "array",
            "uniqueItems": true
          },
          "b": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Defect"
            },
            "title": "B",
            "type": "array",
            "uniqueItems": true
          }
        },
        "title": "Defects",
        "type": "object"
      },
      "Identifier": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "Stable across retries of this exact submitted meaning.",
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
      },
      "lease_id": {
        "$ref": "#/$defs/Identifier",
        "description": "Non-secret pair locator, safe to retain with an uncertain draft."
      },
      "choice": {
        "$ref": "#/$defs/Choice"
      },
      "defects": {
        "$ref": "#/$defs/Defects",
        "default": {
          "a": [],
          "b": []
        }
      }
    },
    "required": ["command_id", "lease_id", "choice"],
    "title": "ReceiptQuery",
    "type": "object"
  },
