  "statusView": {
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": ["admission_required", "renewal_required", "ready"],
        "title": "Status",
        "type": "string"
      }
    },
    "required": ["status"],
    "title": "StatusView",
    "type": "object"
  },
  "admissionView": {
    "$defs": {
      "Identifier": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "Stable across retries of this exact submitted meaning.",
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
      },
      "action": {
        "enum": ["bench_admit", "bench_renew"],
        "title": "Action",
        "type": "string"
      },
      "sitekey": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "required": ["command_id", "action", "sitekey"],
    "title": "AdmissionView",
    "type": "object"
  },
  "admissionRequest": {
    "$defs": {
      "ChallengeProof": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "Stable across retries of this exact submitted meaning.",
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
      },
      "proof": {
        "$ref": "#/$defs/ChallengeProof"
      }
    },
    "required": ["command_id", "proof"],
    "title": "AdmissionRequest",
    "type": "object"
  },
  "admissionReplay": {
    "$defs": {
      "ChallengeProof": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "Stable across retries of this exact submitted meaning.",
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
      },
      "proof": {
        "anyOf": [
          {
            "$ref": "#/$defs/ChallengeProof"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Initial admission requires the original proof. Renewal can use its old cookie."
      }
    },
    "required": ["command_id"],
    "title": "AdmissionReplay",
    "type": "object"
  },
  "startSessionRequest": {
    "$defs": {
      "FamilyName": {
        "maxLength": 256,
        "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "Stable across retries of this exact submitted meaning.",
        "format": "uuid",
        "title": "Command Id",
        "type": "string"
      },
      "family": {
        "$ref": "#/$defs/FamilyName"
      }
    },
    "required": ["command_id", "family"],
    "title": "StartSession",
    "type": "object"
  },
  "resumeSessionRequest": {
    "$defs": {
      "Identifier": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      }
    },
    "additionalProperties": false,
