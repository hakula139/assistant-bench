{
  "pane": {
    "$defs": {
      "DiffPane": {
        "additionalProperties": false,
        "description": "A solution as a unified diff of the task's repository.",
        "properties": {
          "render": {
            "const": "diff",
            "title": "Render",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": ["render", "text"],
        "title": "DiffPane",
        "type": "object"
      },
      "HtmlPane": {
        "additionalProperties": false,
        "description": "An HTML output, loaded in a sandboxed frame from the render origin.",
        "properties": {
          "render": {
            "const": "html",
            "title": "Render",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["render", "url"],
        "title": "HtmlPane",
        "type": "object"
      },
      "TextPane": {
        "additionalProperties": false,
        "properties": {
          "render": {
            "const": "text",
            "title": "Render",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": ["render", "text"],
        "title": "TextPane",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "diff": "#/$defs/DiffPane",
        "html": "#/$defs/HtmlPane",
        "text": "#/$defs/TextPane"
      },
      "propertyName": "render"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/TextPane"
      },
      {
        "$ref": "#/$defs/HtmlPane"
      },
      {
        "$ref": "#/$defs/DiffPane"
      }
    ]
  },
  "familyView": {
    "$defs": {
      "Defect": {
        "enum": [
          "facts",
          "mechanics",
          "tone",
          "formulaic",
          "length",
          "scope",
          "conventions",
          "complexity",
          "testing",
          "clarity"
        ],
        "type": "string"
      },
      "FamilyName": {
        "maxLength": 256,
        "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "A family the vote page can start a session on.",
    "properties": {
      "name": {
        "$ref": "#/$defs/FamilyName",
        "description": "Stable family ID."
      },
      "aspect": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Site aspect ID, absent for family-specific boards.",
        "title": "Aspect"
      },
      "display_name": {
        "title": "Display Name",
        "type": "string"
      },
      "defects": {
        "description": "Available output tags, in the family's order.",
        "items": {
          "$ref": "#/$defs/Defect"
        },
        "title": "Defects",
        "type": "array"
      }
    },
    "required": ["name", "aspect", "display_name", "defects"],
    "title": "FamilyView",
    "type": "object"
  },
  "pairView": {
    "$defs": {
      "Capability": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "DiffPane": {
