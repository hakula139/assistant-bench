          "propertyName": "render"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextPane"
          },
          {
            "$ref": "#/$defs/HtmlPane"
          },
          {
            "$ref": "#/$defs/DiffPane"
          }
        ]
      },
      "TextPane": {
        "additionalProperties": false,
        "properties": {
          "render": {
            "const": "text",
            "title": "Render",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": ["render", "text"],
        "title": "TextPane",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "$ref": "#/$defs/Identifier",
        "description": "Non-secret lease locator for exact receipt recovery."
      },
      "capability": {
        "$ref": "#/$defs/Capability"
      },
      "instruction": {
        "title": "Instruction",
        "type": "string"
      },
      "checklist": {
        "items": {
          "type": "string"
        },
        "title": "Checklist",
        "type": "array"
      },
      "a": {
        "$ref": "#/$defs/Pane"
      },
      "b": {
        "$ref": "#/$defs/Pane"
      }
    },
    "required": ["id", "capability", "instruction", "checklist", "a", "b"],
    "title": "PairView",
    "type": "object"
  },
