        "type": "string"
      }
    },
    "required": ["status"],
    "title": "FreshnessView",
    "type": "object"
  },
  "errorView": {
    "$defs": {
      "ErrorCode": {
        "enum": [
          "invalid_request",
          "admission_required",
          "renewal_required",
          "challenge_rejected",
          "rate_limited",
          "not_found",
          "conflict",
