      },
      "family": {
        "$ref": "#/$defs/FamilyView"
      },
      "votes": {
        "description": "Current selected choices from this session.",
        "minimum": 0,
        "title": "Votes",
        "type": "integer"
      },
      "remaining": {
        "description": "Drawable cases, including the current pending pair's case.",
        "minimum": 0,
        "title": "Remaining",
        "type": "integer"
      },
      "undo_acknowledgment": {
        "anyOf": [
          {
            "$ref": "#/$defs/Identifier"
          },
