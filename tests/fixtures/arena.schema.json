          "length",
          "scope",
          "conventions",
          "complexity",
          "testing",
          "clarity"
        ],
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "The defects tagged on each side's output.",
    "properties": {
      "a": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Defect"
